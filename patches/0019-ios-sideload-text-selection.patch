+// [ios-blink-sideload] The rect of the caret at a selection bound.
+CGRect RectForBound(const gfx::SelectionBound& bound) {
+  return CGRectMake(bound.edge_start_rounded().x(),
+                    bound.edge_start_rounded().y(), 1, bound.GetHeight());
+}
+
+// [ios-blink-sideload] The middle of a selection bound's edge. Unlike the top
+// of the edge, it is safely within the bound's line of text.
+gfx::Point MiddleOfBound(const gfx::SelectionBound& bound) {
+  return gfx::ToRoundedPoint(
+      gfx::PointF((bound.edge_start().x() + bound.edge_end().x()) / 2,
+                  (bound.edge_start().y() + bound.edge_end().y()) / 2));
