   // once its RenderWidgetHostViewIOS is gone (the edit commands CHECK it).
   // Claiming every action made UIKit send this view actions it lacks, such as
   // the embedder's keyboard shortcuts, which crashed with "unrecognized
-  // selector".
-  return _view && [self respondsToSelector:action];
+  // selector". Implemented means by this class, not UIView: UIKit's categories
+  // make every view respond to some private actions, such as the edit menu's
+  // _translate:, which do nothing here.
+  if (!_view || [self methodForSelector:action] ==
+                    [UIView instanceMethodForSelector:action]) {
+    return NO;
+  }
+  // [ios-blink-sideload] The system edit menu offers the actions this returns
+  // YES for, so only claim those that apply to the current selection.
+  BOOL hasSelection = [self selectedText].length > 0;
+  if (action == @selector(copy:) || action == @selector(lookup:) ||
+      action == @selector(translate:) || action == @selector(share:)) {
+    return hasSelection;
+  }
+  if (action == @selector(cut:)) {
+    return hasSelection && _isEditable;
+  }
+  if (action == @selector(paste:)) {
+    return _isEditable && UIPasteboard.generalPasteboard.hasStrings;
+  }
+  if (action == @selector(select:)) {
+    return _isEditable && !hasSelection && [self hasText];
+  }
+  if (action == @selector(addShortcut:)) {
+    // Learn…, which adds a text replacement for the keyboard, as in text
+    // fields elsewhere.
+    return hasSelection && _isEditable;
+  }
+  if (action == @selector(selectAll:)) {
+    // Safari offers Select All for text fields only, but Command-A selects the
+    // whole page.
+    return _isEditable || [sender isKindOfClass:[UIKeyCommand class]];
+  }
+  if (action == @selector(showWritingTools:)) {
+    // UIResponder's Writing Tools need text access this view lacks.
+    return NO;
+  }
+  return YES;
+}
+
+// [ios-blink-sideload] Keeps the system edit menu to what Safari offers for the
+// selection: the menu also gets commands that other responders in the chain
+// can perform, such as Select All and AutoFill outside text fields.
+- (NSArray<UIMenuElement*>*)editMenuElementsFrom:
+    (NSArray<UIMenuElement*>*)elements {
+  NSMutableArray<UIMenuElement*>* kept = [NSMutableArray array];
+  for (UIMenuElement* element in elements) {
+    if (UIMenu* menu = base::apple::ObjCCast<UIMenu>(element)) {
+      if (!_isEditable && [menu.identifier isEqual:UIMenuAutoFill]) {
+        continue;
+      }
+      NSArray<UIMenuElement*>* children =
+          [self editMenuElementsFrom:menu.children];
+      if (children.count) {
+        [kept addObject:[menu menuByReplacingChildren:children]];
+      }
+    } else if (UICommand* command =
+                   base::apple::ObjCCast<UICommand>(element)) {
+      // The menu's Look Up and Translate use UIKit's private actions; send
+      // them to this view's BETextInput ones instead, keeping their titles.
+      SEL action = command.action;
+      if (action == NSSelectorFromString(@"_define:")) {
+        action = @selector(lookup:);
+      } else if (action == NSSelectorFromString(@"_translate:")) {
+        action = @selector(translate:);
+      }
+      if (![self canPerformAction:action withSender:nil]) {
+        continue;
+      }
+      [kept addObject:action == command.action
+                          ? command
+                          : [UICommand commandWithTitle:command.title
+                                                  image:command.image
+                                                 action:action
+                                           propertyList:nil]];
+    } else {
+      [kept addObject:element];
+    }
+  }
+  return kept;
+}
+
+- (void)buildMenuWithBuilder:(id<UIMenuBuilder>)builder {
+  [super buildMenuWithBuilder:builder];
+  if (builder.system != UIMenuSystem.contextSystem) {
+    return;
+  }
+  [builder replaceChildrenOfMenuForIdentifier:UIMenuRoot
+                            fromChildrenBlock:^(
+                                NSArray<UIMenuElement*>* children) {
+                              return [self editMenuElementsFrom:children];
+                            }];
+}
+
+// [ios-blink-sideload] Where the selection is, for the sheets of the actions
+// below to point at.
+- (CGRect)selectionPresentationRect {
+  auto* region = [self selectionRegion];
+  if (!region) {
+    return CGRectNull;
+  }
+  return region->bounding_box.IsEmpty()
+             ? CGRectUnion(RectForBound(region->anchor),
+                           RectForBound(region->focus))
+             : region->bounding_box.ToCGRect();
+}
+
+// [ios-blink-sideload] The edit menu's Look Up, Translate and Share, as in
+// Safari.
+- (void)lookup:(nullable id)sender {
+  NSString* text = [self selectedText];
+  if (!text.length) {
+    return;
+  }
+  [text_interaction_
+      showDictionaryForTextInContext:text
+                 definingTextInRange:NSMakeRange(0, text.length)
+                            fromRect:[self selectionPresentationRect]];
+}
+
+- (void)translate:(nullable id)sender {
+  NSString* text = [self selectedText];
+  if (!text.length) {
+    return;
+  }
+  [text_interaction_ translateText:text
+                          fromRect:[self selectionPresentationRect]];
+}
+
+- (void)share:(nullable id)sender {
+  NSString* text = [self selectedText];
+  if (!text.length) {
+    return;
+  }
+  [text_interaction_ shareText:text fromRect:[self selectionPresentationRect]];
+}
+
+- (void)addShortcut:(nullable id)sender {
+  NSString* text = [self selectedText];
+  if (!text.length) {
+    return;
+  }
+  [text_interaction_ addShortcutForText:text
+                               fromRect:[self selectionPresentationRect]];
+}
+
+// [ios-blink-sideload] The edit menu's Select, for a caret in a text field.
+- (void)select:(nullable id)sender {
+  [self handleEditCommands:{"selectWord"}];
 }
 
