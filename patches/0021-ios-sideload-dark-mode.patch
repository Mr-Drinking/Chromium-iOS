 #import "components/version_info/version_info.h"
 #import "content/public/browser/browser_context.h"
 #import "content/public/browser/devtools_manager_delegate.h"
+#import "content/public/browser/web_contents.h"
 #import "content/public/browser/web_contents_view_delegate.h"
 #import "content/public/common/url_constants.h"
 #import "ios/web/content/common/constants.h"
@@ -16,11 +17,22 @@
 #import "ios/web/content/ui/web_contents_view_delegate_impl.h"
 #import "services/network/public/mojom/network_context.mojom.h"
 #include "third_party/blink/public/common/switches.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "ui/native_theme/native_theme.h"
 
 namespace web {
 
 namespace {
 
+// [ios-blink-sideload] The color scheme pages should prefer: the system's
+// light or dark appearance, as in Safari.
+blink::mojom::PreferredColorScheme GetWebColorScheme() {
+  return ui::NativeTheme::GetInstanceForWeb()->preferred_color_scheme() ==
+                 ui::NativeTheme::PreferredColorScheme::kDark
+             ? blink::mojom::PreferredColorScheme::kDark
+             : blink::mojom::PreferredColorScheme::kLight;
+}
+
 base::FilePath GetPartitionPath(content::BrowserContext* context,
                                 const base::FilePath& relative_partition_path) {
   base::FilePath path = context->GetPath();
@@ -103,6 +115,26 @@ IOSContentBrowserClient::CreateDevToolsManagerDelegate() {
   return std::make_unique<content::DevToolsManagerDelegate>();
 }
 
+void IOSContentBrowserClient::OverrideWebPreferences(
+    content::WebContents* web_contents,
+    content::SiteInstance& main_frame_site,
+    blink::web_pref::WebPreferences* prefs) {
+  // [ios-blink-sideload] Pages follow the system appearance
+  // (prefers-color-scheme, and the default colors of pages that support dark
+  // mode). They were always light.
+  prefs->preferred_color_scheme = GetWebColorScheme();
+  prefs->preferred_root_scrollbar_color_scheme = prefs->preferred_color_scheme;
+}
+
+bool IOSContentBrowserClient::
+    WebPreferencesNeedUpdateForColorRelatedStateChanges(
+        content::WebContents& web_contents,
+        const content::SiteInstance& main_frame_site) const {
+  // [ios-blink-sideload] Called when the system appearance changes.
+  return web_contents.GetOrCreateWebPreferences().preferred_color_scheme !=
+         GetWebColorScheme();
+}
+
 void IOSContentBrowserClient::ConfigureNetworkContextParams(
     content::BrowserContext* context,
     bool in_memory,
