diff --git a/ui/native_theme/os_settings_provider_ios.h b/ui/native_theme/os_settings_provider_ios.h
new file mode 100644
index 0000000000000000000000000000000000000000..0bfdf36bd17a36ee79ec09deaea2739f9090068d
--- /dev/null
+++ b/ui/native_theme/os_settings_provider_ios.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_NATIVE_THEME_OS_SETTINGS_PROVIDER_IOS_H_
+#define UI_NATIVE_THEME_OS_SETTINGS_PROVIDER_IOS_H_
+
+#include <atomic>
+#include <memory>
+
+#include "base/component_export.h"
+#include "ui/native_theme/os_settings_provider.h"
+
+namespace ui {
+
+// [ios-blink-sideload] Reports the system's light or dark appearance, and when
+// it changes, so that web pages can follow it (prefers-color-scheme) as they
+// do in Safari. iOS had no provider, so pages always saw a light system.
+class COMPONENT_EXPORT(NATIVE_THEME) OsSettingsProviderIOS
+    : public OsSettingsProvider {
+ public:
+  explicit OsSettingsProviderIOS(
+      PriorityLevel priority_level = PriorityLevel::kProduction);
+  OsSettingsProviderIOS(const OsSettingsProviderIOS&) = delete;
+  OsSettingsProviderIOS& operator=(const OsSettingsProviderIOS&) = delete;
+  ~OsSettingsProviderIOS() override;
+
+  // OsSettingsProvider:
+  bool DarkColorSchemeAvailable() const override;
+  NativeTheme::PreferredColorScheme PreferredColorScheme() const override;
+
+ private:
+  // Starts observing the appearance of the app's window scenes. Main thread
+  // only.
+  void ObserveScenes();
+
+  // Reads the appearance again, and notifies observers if it changed. Main
+  // thread only.
+  void UpdateAppearance();
+
+  // Because this header is #included from C++ source, we can't use Obj-C here.
+  // Instead the Obj-C members are defined entirely in the .mm.
+  struct ObjCMembers;
+
+  std::unique_ptr<ObjCMembers> objc_members_;
+
+  // Whether the appearance is dark. Atomic because in single-process mode the
+  // renderer thread can read it too.
+  std::atomic<bool> dark_{false};
+};
+
+}  // namespace ui
+
+#endif  // UI_NATIVE_THEME_OS_SETTINGS_PROVIDER_IOS_H_
diff --git a/ui/native_theme/os_settings_provider_ios.mm b/ui/native_theme/os_settings_provider_ios.mm
new file mode 100644
index 0000000000000000000000000000000000000000..12ea68265f1b60426660333c9a9e8e5edca52344
--- /dev/null
+++ b/ui/native_theme/os_settings_provider_ios.mm
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/native_theme/os_settings_provider_ios.h"
+
+#import <UIKit/UIKit.h>
+
+#include "base/apple/foundation_util.h"
+
+namespace ui {
+
+namespace {
+
+// Whether the app's window scenes, and so the system, look dark. A scene in
+// the foreground decides.
+bool ScenesAreDark() {
+  bool dark = false;
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    UIWindowScene* window_scene = base::apple::ObjCCast<UIWindowScene>(scene);
+    if (!window_scene) {
+      continue;
+    }
+    dark = window_scene.traitCollection.userInterfaceStyle ==
+           UIUserInterfaceStyleDark;
+    if (window_scene.activationState ==
+        UISceneActivationStateForegroundActive) {
+      break;
+    }
+  }
+  return dark;
+}
+
+}  // namespace
+
+struct OsSettingsProviderIOS::ObjCMembers {
+  // The trait change registration of each observed window scene.
+  NSMapTable<UIWindowScene*, id<UITraitChangeRegistration>>* __strong
+      registrations;
+  id __strong scene_activation_token;
+};
+
+OsSettingsProviderIOS::OsSettingsProviderIOS(PriorityLevel priority_level)
+    : OsSettingsProvider(priority_level),
+      objc_members_(std::make_unique<ObjCMembers>()) {
+  objc_members_->registrations = [NSMapTable weakToStrongObjectsMapTable];
+  if (NSThread.isMainThread) {
+    // No notification here: this runs while `Get()` creates the provider.
+    ObserveScenes();
+    dark_ = ScenesAreDark();
+    return;
+  }
+  __block auto provider = this;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    provider->ObserveScenes();
+    provider->UpdateAppearance();
+  });
+}
+
+OsSettingsProviderIOS::~OsSettingsProviderIOS() {
+  if (objc_members_->scene_activation_token) {
+    [NSNotificationCenter.defaultCenter
+        removeObserver:objc_members_->scene_activation_token];
+  }
+  for (UIWindowScene* scene in objc_members_->registrations) {
+    [scene unregisterForTraitChanges:[objc_members_->registrations
+                                         objectForKey:scene]];
+  }
+}
+
+bool OsSettingsProviderIOS::DarkColorSchemeAvailable() const {
+  return true;
+}
+
+NativeTheme::PreferredColorScheme OsSettingsProviderIOS::PreferredColorScheme()
+    const {
+  return dark_ ? NativeTheme::PreferredColorScheme::kDark
+               : NativeTheme::PreferredColorScheme::kLight;
+}
+
+void OsSettingsProviderIOS::ObserveScenes() {
+  __block auto provider = this;
+  void (^observe)(UIScene*) = ^(UIScene* scene) {
+    UIWindowScene* window_scene = base::apple::ObjCCast<UIWindowScene>(scene);
+    NSMapTable* registrations = provider->objc_members_->registrations;
+    if (!window_scene || [registrations objectForKey:window_scene]) {
+      return;
+    }
+    id<UITraitChangeRegistration> registration = [window_scene
+        registerForTraitChanges:@[ [UITraitUserInterfaceStyle class] ]
+                    withHandler:^(id<UITraitEnvironment> environment,
+                                  UITraitCollection* previous) {
+                      provider->UpdateAppearance();
+                    }];
+    [registrations setObject:registration forKey:window_scene];
+  };
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    observe(scene);
+  }
+  // Scenes connect after the app starts, and the appearance can change while
+  // the app is in the background.
+  objc_members_->scene_activation_token = [NSNotificationCenter.defaultCenter
+      addObserverForName:UISceneDidActivateNotification
+                  object:nil
+                   queue:nil
+              usingBlock:^(NSNotification* notification) {
+                observe(notification.object);
+                provider->UpdateAppearance();
+              }];
+}
+
+void OsSettingsProviderIOS::UpdateAppearance() {
+  bool dark = ScenesAreDark();
+  if (dark_.exchange(dark) != dark) {
+    NotifyOnSettingsChanged();
+  }
+}
+
+}  // namespace ui
