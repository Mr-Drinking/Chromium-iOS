       CHECK(frame_tree_node);
       CHECK(frame_tree_node->navigation_request());
 
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> webui_factory;
+#if BUILDFLAG(IS_IOS)
+      // [ios-blink-sideload] Ask the embedder first: Chrome's iOS WebUI isn't
+      // content's, and serves its chrome:// pages itself.
+      webui_factory =
+          GetContentClient()->browser()->CreateNonNetworkNavigationURLLoaderFactory(
+              scheme, frame_tree_node_id_);
