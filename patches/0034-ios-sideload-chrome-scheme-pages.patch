+// [ios-blink-sideload] Forwards content's requests for chrome:// URLs to the
+// BrowserState's network stack (see CreateWebUIURLLoaderFactory()), without
+// the frame's DevTools throttling profile: that stack runs on the IO thread,
+// and the process-wide throttling state may only be used on the thread of
+// content's network service. With it, the next page from content's network
+// service hit a DCHECK (ThrottlingController's thread checker).
+class WebUIURLLoaderFactory : public network::SelfDeletingURLLoaderFactory {
+ public:
+  WebUIURLLoaderFactory(
+      scoped_refptr<network::SharedURLLoaderFactory> browser_state_factory,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key),
+        browser_state_factory_(std::move(browser_state_factory)) {}
+
+  WebUIURLLoaderFactory(const WebUIURLLoaderFactory&) = delete;
+  WebUIURLLoaderFactory& operator=(const WebUIURLLoaderFactory&) = delete;
+
+ private:
+  ~WebUIURLLoaderFactory() override = default;
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override {
+    network::ResourceRequest browser_state_request(request);
+    browser_state_request.throttling_profile_id.reset();
+    browser_state_factory_->CreateLoaderAndStart(
+        std::move(loader), request_id, options, browser_state_request,
+        std::move(client), traffic_annotation);
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> browser_state_factory_;
+};
+
+// [ios-blink-sideload] Loads chrome:// URLs through the BrowserState's network
+// stack, which serves the data sources of Chrome's iOS WebUI
+// (URLDataManagerIOSBackend), as CRWWebUISchemeHandler does for WebKit.
+mojo::PendingRemote<network::mojom::URLLoaderFactory>
+CreateWebUIURLLoaderFactory(content::BrowserContext* context) {
+  web::BrowserState* browser_state =
+      static_cast<ContentBrowserContext*>(context)->GetBrowserState();
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> factory;
+  base::MakeSelfDeleting<WebUIURLLoaderFactory>(
+      browser_state->GetSharedURLLoaderFactory(),
+      factory.InitWithNewPipeAndPassReceiver());
+  return factory;
+}
+
 }  // namespace
 
 bool IOSContentBrowserClient::IsHandledURL(const GURL& url) {
@@ -163,4 +225,41 @@ void IOSContentBrowserClient::ConfigureNetworkContextParams(
   }
 }
 
+mojo::PendingRemote<network::mojom::URLLoaderFactory>
+IOSContentBrowserClient::CreateNonNetworkNavigationURLLoaderFactory(
+    const std::string& scheme,
+    content::FrameTreeNodeId frame_tree_node_id) {
+  // [ios-blink-sideload] See CreateWebUIURLLoaderFactory().
+  if (scheme != content::kChromeUIScheme) {
+    return {};
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromFrameTreeNodeId(frame_tree_node_id);
+  if (!web_contents) {
+    return {};
+  }
+  return CreateWebUIURLLoaderFactory(web_contents->GetBrowserContext());
+}
+
+void IOSContentBrowserClient::RegisterNonNetworkSubresourceURLLoaderFactories(
+    int render_process_id,
+    int render_frame_id,
+    const std::optional<url::Origin>& request_initiator_origin,
+    NonNetworkURLLoaderFactoryMap* factories) {
+  // [ios-blink-sideload] Only chrome:// pages load chrome:// resources, such
+  // as the shared ones under chrome://resources.
+  if (!request_initiator_origin ||
+      request_initiator_origin->scheme() != content::kChromeUIScheme) {
+    return;
+  }
+  content::RenderFrameHost* render_frame_host =
+      content::RenderFrameHost::FromID(render_process_id, render_frame_id);
+  if (!render_frame_host) {
+    return;
+  }
+  factories->emplace(
+      content::kChromeUIScheme,
+      CreateWebUIURLLoaderFactory(render_frame_host->GetBrowserContext()));
+}
+
 }  // namespace web
