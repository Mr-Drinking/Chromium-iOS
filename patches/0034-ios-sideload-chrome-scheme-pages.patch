+void ContentWebState::HandleWebUIMessage(const ScriptMessage& script_message) {
+  // [ios-blink-sideload] With the checks WebUIMessagingJavaScriptFeature makes
+  // for WebKit: only from the main frame of the chrome:// page it came from.
+  if (!web_ui_ || !script_message.is_main_frame()) {
+    return;
+  }
+  std::optional<GURL> url = script_message.request_url();
+  if (!url || !GetWebClient()->IsAppSpecificURL(*url) ||
+      !script_message.security_origin().IsSameOriginWith(
+          url::Origin::Create(*url))) {
+    return;
+  }
+  const base::DictValue* dict = script_message.legacy_body()
+                                    ? script_message.legacy_body()->GetIfDict()
+                                    : nullptr;
+  if (!dict) {
+    return;
+  }
+  const std::string* message = dict->FindString("message");
+  const base::ListValue* arguments = dict->FindList("arguments");
+  if (!message || !arguments) {
+    return;
+  }
+  web_ui_->ProcessWebUIIOSMessage(*url, *message, *arguments);
+}
+
+WebState::InterfaceBinder* ContentWebState::GetInterfaceBinderForMainFrame() {
+  return &interface_binder_;
+}
+
+void ContentWebState::CreateWebUI(const GURL& url) {
+  // [ios-blink-sideload] As WebStateImpl::RealizedWebState does: the
+  // controller registers the page's data sources (see
+  // IOSContentBrowserClient::CreateNonNetworkNavigationURLLoaderFactory()) and
+  // its message handlers.
+  if (web_ui_) {
+    if (web_ui_->GetController()->GetHost() == url.GetHost()) {
+      return;
+    }
+    ClearWebUI();
+  }
+  WebUIIOSControllerFactory* factory =
+      WebUIIOSControllerFactoryRegistry::GetInstance();
+  if (!factory) {
+    return;
+  }
+  auto web_ui = std::make_unique<WebUIIOSImpl>(this);
+  std::unique_ptr<WebUIIOSController> controller =
+      factory->CreateWebUIIOSControllerForURL(web_ui.get(), url);
+  if (!controller) {
+    return;
+  }
+  web_ui->SetController(std::move(controller));
+  web_ui_ = std::move(web_ui);
+}
+
+void ContentWebState::ClearWebUI() {
+  web_ui_.reset();
+}
