diff --git a/third_party/blink/renderer/platform/fonts/ios/font_cache_ios.mm b/third_party/blink/renderer/platform/fonts/ios/font_cache_ios.mm
index 429dd9dd628aed32999bfe7c4142e61bfffd16f0..a5370a3167b065c17b4053d3298117869c1990c2 100644
--- a/third_party/blink/renderer/platform/fonts/ios/font_cache_ios.mm
+++ b/third_party/blink/renderer/platform/fonts/ios/font_cache_ios.mm
@@ -4,11 +4,142 @@
 
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 
+#import <UIKit/UIKit.h>
+
+#include <algorithm>
+
 #include "skia/ext/font_utils.h"
+#include "third_party/blink/renderer/platform/font_family_names.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
 #include "third_party/blink/renderer/platform/fonts/font_platform_data.h"
+#include "third_party/blink/renderer/platform/fonts/ios/system_font_ios.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "third_party/skia/include/core/SkFontArguments.h"
+#include "third_party/skia/include/core/SkFontParameters.h"
+#include "third_party/skia/include/core/SkTypeface.h"
+#include "third_party/skia/include/ports/SkTypeface_mac.h"
 
 namespace blink {
 
+namespace {
+
+// [ios-blink-sideload] The nearest UIFontWeight to a CSS font weight.
+UIFontWeight UIFontWeightForCSSWeight(float weight) {
+  if (weight <= 150) {
+    return UIFontWeightUltraLight;
+  }
+  if (weight <= 250) {
+    return UIFontWeightThin;
+  }
+  if (weight <= 350) {
+    return UIFontWeightLight;
+  }
+  if (weight <= 450) {
+    return UIFontWeightRegular;
+  }
+  if (weight <= 550) {
+    return UIFontWeightMedium;
+  }
+  if (weight <= 650) {
+    return UIFontWeightSemibold;
+  }
+  if (weight <= 750) {
+    return UIFontWeightBold;
+  }
+  if (weight <= 850) {
+    return UIFontWeightHeavy;
+  }
+  return UIFontWeightBlack;
+}
+
+// [ios-blink-sideload] Like FontPlatformDataFromCTFont() on Mac: shape with the
+// optical size of the text. HarfBuzz otherwise uses the default instance (opsz
+// 28 for SF Pro), which sets body text noticeably tighter than Safari does.
+sk_sp<SkTypeface> WithOpticalSize(sk_sp<SkTypeface> typeface, float size) {
+  constexpr SkFourByteTag kOpszTag = SkSetFourByteTag('o', 'p', 's', 'z');
+  int axis_count = typeface->getVariationDesignParameters({});
+  if (axis_count <= 0) {
+    return typeface;
+  }
+  Vector<SkFontParameters::Variation::Axis> axes(axis_count);
+  Vector<SkFontArguments::VariationPosition::Coordinate> position(axis_count);
+  if (typeface->getVariationDesignParameters(axes) != axis_count ||
+      typeface->getVariationDesignPosition(position) != axis_count) {
+    return typeface;
+  }
+  bool changed = false;
+  for (auto& coordinate : position) {
+    if (coordinate.axis != kOpszTag) {
+      continue;
+    }
+    for (const auto& axis : axes) {
+      if (axis.tag == kOpszTag) {
+        float value = std::clamp(size, axis.min, axis.max);
+        changed = value != coordinate.value;
+        coordinate.value = value;
+      }
+    }
+  }
+  if (!changed) {
+    return typeface;
+  }
+  SkFontArguments::VariationPosition variation{position.data(),
+                                               static_cast<int>(axis_count)};
+  sk_sp<SkTypeface> clone = typeface->makeClone(
+      SkFontArguments().setVariationDesignPosition(variation));
+  return clone ? clone : typeface;
+}
+
+}  // namespace
+
+// [ios-blink-sideload] See system_font_ios.h. UIKit, not CoreText, because
+// only UIKit exposes the system font designs (kCTFontUIFontUserFixedPitch is
+// Menlo, not SF Mono).
+sk_sp<SkTypeface> MakeIOSSystemFontTypeface(
+    const FontDescription& font_description,
+    const AtomicString& family) {
+  UIFontDescriptorSystemDesign design = nil;
+  if (EqualIgnoringAsciiCase(family, "ui-serif")) {
+    design = UIFontDescriptorSystemDesignSerif;
+  } else if (EqualIgnoringAsciiCase(family, "ui-monospace")) {
+    design = UIFontDescriptorSystemDesignMonospaced;
+  } else if (EqualIgnoringAsciiCase(family, "ui-rounded")) {
+    design = UIFontDescriptorSystemDesignRounded;
+  } else if (family != font_family_names::kSystemUi &&
+             !EqualIgnoringAsciiCase(family, "ui-sans-serif")) {
+    return nullptr;
+  }
+
+  // Fonts can be created on threads without an autorelease pool.
+  @autoreleasepool {
+    CGFloat size = std::max(font_description.EffectiveFontSize(), 1.0f);
+    UIFont* font = [UIFont
+        systemFontOfSize:size
+                  weight:UIFontWeightForCSSWeight(
+                             static_cast<float>(font_description.Weight()))];
+    UIFontDescriptor* descriptor = font.fontDescriptor;
+    if (design) {
+      descriptor = [descriptor fontDescriptorWithDesign:design] ?: descriptor;
+    }
+    if (font_description.Style() != kNormalSlopeValue) {
+      descriptor =
+          [descriptor
+              fontDescriptorWithSymbolicTraits:descriptor.symbolicTraits |
+                                               UIFontDescriptorTraitItalic]
+              ?: descriptor;
+    }
+    font = [UIFont fontWithDescriptor:descriptor size:size];
+    sk_sp<SkTypeface> typeface =
+        SkMakeTypefaceFromCTFont((__bridge CTFontRef)font);
+    if (typeface &&
+        font_description.FontOpticalSizing() == OpticalSizing::kAuto) {
+      typeface = WithOpticalSize(std::move(typeface),
+                                 font_description.SpecifiedSize());
+    }
+    return typeface;
+  }
+}
+
 static AtomicString& MutableSystemFontFamily() {
   DEFINE_THREAD_SAFE_STATIC_LOCAL(AtomicString, system_font_family, ());
   return system_font_family;
diff --git a/third_party/blink/renderer/platform/fonts/ios/system_font_ios.h b/third_party/blink/renderer/platform/fonts/ios/system_font_ios.h
new file mode 100644
index 0000000000000000000000000000000000000000..32ef04d77d412f6a8687d5b8cab27373212f22bd
--- /dev/null
+++ b/third_party/blink/renderer/platform/fonts/ios/system_font_ios.h
@@ -0,0 +1,27 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_IOS_SYSTEM_FONT_IOS_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_IOS_SYSTEM_FONT_IOS_H_
+
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+
+class SkTypeface;
+
+namespace blink {
+
+class FontDescription;
+
+// [ios-blink-sideload] Returns the iOS system font (SF Pro, New York, SF Mono
+// or SF Rounded) for system-ui and the ui-sans-serif, ui-serif, ui-monospace
+// and ui-rounded families, or null for any other family. These fonts have
+// dot-prefixed names that CoreText does not match by family name.
+sk_sp<SkTypeface> MakeIOSSystemFontTypeface(
+    const FontDescription& font_description,
+    const AtomicString& family);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_IOS_SYSTEM_FONT_IOS_H_
diff --git a/third_party/blink/renderer/platform/fonts/skia/font_cache_skia.cc b/third_party/blink/renderer/platform/fonts/skia/font_cache_skia.cc
index 0e1e1c8e5237fb246826e3405eca5909dd8503a0..980fefcbe9683b243b8d2802b6245a2b89a10c1e 100644
--- a/third_party/blink/renderer/platform/fonts/skia/font_cache_skia.cc
+++ b/third_party/blink/renderer/platform/fonts/skia/font_cache_skia.cc
@@ -61,6 +61,10 @@
 #include "third_party/skia/include/core/SkStream.h"
 #include "third_party/skia/include/core/SkTypeface.h"
 
+#if BUILDFLAG(IS_IOS)
+#include "third_party/blink/renderer/platform/fonts/ios/system_font_ios.h"
+#endif
+
 #if BUILDFLAG(IS_MAC)
 #error This file should not be used by MacOS.
 #endif
@@ -292,6 +296,14 @@ sk_sp<SkTypeface> FontCache::CreateTypeface(
 #endif
 
   const AtomicString& family = creation_params.Family();
+#if BUILDFLAG(IS_IOS)
+  // [ios-blink-sideload] system-ui and the ui-* families are the system fonts.
+  if (sk_sp<SkTypeface> typeface =
+          MakeIOSSystemFontTypeface(font_description, family)) {
+    name = family.Utf8();
+    return typeface;
+  }
+#endif
   DCHECK_NE(family, font_family_names::kSystemUi);
   // convert the name to utf8
   name = family.Utf8();
