+// [ios-blink-sideload] Find in Page, with the system find navigator searching
+// through content's find (see CRCFindInPageController). This said it was not
+// supported, so Chrome disabled Find in Page.
 bool ContentWebState::IsFindInteractionSupported() {
-  return false;
+  return true;
 }
 
 bool ContentWebState::IsFindInteractionEnabled() {
-  return false;
+  return find_in_page_controller_ != nil;
 }
 
-void ContentWebState::SetFindInteractionEnabled(bool enabled) {}
+void ContentWebState::SetFindInteractionEnabled(bool enabled) {
+  if (enabled == IsFindInteractionEnabled()) {
+    return;
+  }
+  if (enabled) {
+    find_in_page_controller_ =
+        [[CRCFindInPageController alloc] initWithWebContents:web_contents_.get()
+                                                        view:web_view_];
+  } else {
+    [find_in_page_controller_ detach];
+    find_in_page_controller_ = nil;
+  }
+}
 
 id<CRWFindInteraction> ContentWebState::GetFindInteraction() {
-  return nil;
+  if (!find_in_page_controller_) {
+    return nil;
+  }
+  return [[CRWFindInteraction alloc]
+      initWithUIFindInteraction:find_in_page_controller_.findInteraction];
+}
+
+void ContentWebState::DidReceiveFindReply(int request_id,
+                                          int number_of_matches,
+                                          const gfx::Rect& selection_rect,
+                                          int active_match_ordinal,
+                                          bool final_update) {
+  [find_in_page_controller_ didReceiveFindReplyForRequest:request_id
+                                          numberOfMatches:number_of_matches
+                                       activeMatchOrdinal:active_match_ordinal];
 }
 
 id ContentWebState::GetActivityItem() {
