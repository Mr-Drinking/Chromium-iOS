+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_WEB_STATE_CRC_FIND_IN_PAGE_CONTROLLER_H_
+#define IOS_WEB_CONTENT_WEB_STATE_CRC_FIND_IN_PAGE_CONTROLLER_H_
+
+#import <UIKit/UIKit.h>
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// [ios-blink-sideload] Find in Page for Blink: the system find navigator
+// (UIFindInteraction), as WKWebView has, searching with content's find
+// (WebContents::Find). Blink highlights the matches and scrolls to the active
+// one; the navigator shows which match it is and how many there are.
+@interface CRCFindInPageController : NSObject
+
+// Adds a find interaction to `view`, searching `webContents`.
+- (instancetype)initWithWebContents:(content::WebContents*)webContents
+                               view:(UIView*)view NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
+
+@property(nonatomic, readonly) UIFindInteraction* findInteraction;
+
+// Passes on a reply from content's find
+// (WebContentsObserver::DidReceiveFindReply()).
+- (void)didReceiveFindReplyForRequest:(int)requestID
+                      numberOfMatches:(int)numberOfMatches
+                   activeMatchOrdinal:(int)activeMatchOrdinal;
+
+// Dismisses the find navigator and removes the find interaction from its view.
+- (void)detach;
+
+@end
+
+#endif  // IOS_WEB_CONTENT_WEB_STATE_CRC_FIND_IN_PAGE_CONTROLLER_H_
diff --git a/ios/web/content/web_state/crc_find_in_page_controller.mm b/ios/web/content/web_state/crc_find_in_page_controller.mm
new file mode 100644
index 0000000000000000000000000000000000000000..c47d74198861396c061a7b7da865be6ab24ebd59
--- /dev/null
+++ b/ios/web/content/web_state/crc_find_in_page_controller.mm
@@ -0,0 +1,217 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/web_state/crc_find_in_page_controller.h"
+
+#import <string>
+
+#import "base/apple/foundation_util.h"
+#import "base/memory/weak_ptr.h"
+#import "base/strings/sys_string_conversions.h"
+#import "content/public/browser/web_contents.h"
+#import "third_party/blink/public/mojom/frame/find_in_page.mojom.h"
+
+namespace {
+
+// No find session yet, as FindRequestManager::kInvalidId.
+constexpr int kNoSession = -1;
+
+}  // namespace
+
+// A find session of the find navigator, run by content's find.
+@interface CRCFindSession : UIFindSession
+
+- (instancetype)initWithWebContents:
+                    (base::WeakPtr<content::WebContents>)webContents
+                        interaction:(UIFindInteraction*)interaction
+    NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
+
+- (void)didReceiveFindReplyForRequest:(int)requestID
+                      numberOfMatches:(int)numberOfMatches
+                   activeMatchOrdinal:(int)activeMatchOrdinal;
+
+@end
+
+@implementation CRCFindSession {
+  base::WeakPtr<content::WebContents> _webContents;
+  __weak UIFindInteraction* _interaction;
+  std::u16string _query;
+  BOOL _matchCase;
+  // The request that started the current search. Replies to earlier ones are
+  // stale.
+  int _sessionID;
+  NSInteger _resultCount;
+  NSInteger _highlightedResultIndex;
+}
+
+- (instancetype)initWithWebContents:
+                    (base::WeakPtr<content::WebContents>)webContents
+                        interaction:(UIFindInteraction*)interaction {
+  self = [super init];
+  if (self) {
+    _webContents = webContents;
+    _interaction = interaction;
+    _sessionID = kNoSession;
+    _highlightedResultIndex = NSNotFound;
+  }
+  return self;
+}
+
+- (NSInteger)resultCount {
+  return _resultCount;
+}
+
+- (NSInteger)highlightedResultIndex {
+  return _highlightedResultIndex;
+}
+
+- (BOOL)supportsReplacement {
+  return NO;
+}
+
+- (void)performSearchWithQuery:(NSString*)query
+                       options:(UITextSearchOptions*)options {
+  // Blink finds substrings only, so the word matching options are ignored.
+  _query = base::SysNSStringToUTF16(query);
+  _matchCase =
+      options && !(options.stringCompareOptions & NSCaseInsensitiveSearch);
+  [self clearResults];
+  if (_query.empty()) {
+    [self stopFinding];
+    return;
+  }
+  [self findForward:YES newSession:YES];
+}
+
+- (void)highlightNextResultInDirection:(UITextStorageDirection)direction {
+  if (_query.empty() || _sessionID == kNoSession) {
+    return;
+  }
+  [self findForward:direction == UITextStorageDirectionForward newSession:NO];
+}
+
+- (void)invalidateFoundResults {
+  [self stopFinding];
+  _query.clear();
+  [self clearResults];
+}
+
+- (void)didReceiveFindReplyForRequest:(int)requestID
+                      numberOfMatches:(int)numberOfMatches
+                   activeMatchOrdinal:(int)activeMatchOrdinal {
+  if (_sessionID == kNoSession || requestID < _sessionID) {
+    return;
+  }
+  // -1 means unchanged.
+  if (numberOfMatches != -1) {
+    _resultCount = numberOfMatches;
+  }
+  if (activeMatchOrdinal != -1) {
+    _highlightedResultIndex =
+        activeMatchOrdinal > 0 ? activeMatchOrdinal - 1 : NSNotFound;
+  }
+  [_interaction updateResultCount];
+}
+
+#pragma mark - Private
+
+- (void)findForward:(BOOL)forward newSession:(BOOL)newSession {
+  if (!_webContents) {
+    return;
+  }
+  auto options = blink::mojom::FindOptions::New();
+  options->forward = forward;
+  options->match_case = _matchCase;
+  options->new_session = newSession;
+  // Content can reply before Find() returns, so take the request's ID as soon
+  // as it is known.
+  int* sessionID = &_sessionID;
+  _webContents->Find(_query, std::move(options), /*skip_delay=*/true,
+                     [sessionID, newSession](int requestID) {
+                       if (newSession) {
+                         *sessionID = requestID;
+                       }
+                     });
+}
+
+- (void)stopFinding {
+  _sessionID = kNoSession;
+  if (_webContents) {
+    _webContents->StopFinding(content::STOP_FIND_ACTION_CLEAR_SELECTION);
+  }
+}
+
+- (void)clearResults {
+  _resultCount = 0;
+  _highlightedResultIndex = NSNotFound;
+  [_interaction updateResultCount];
+}
+
+@end
+
+@interface CRCFindInPageController () <UIFindInteractionDelegate>
+@end
+
+@implementation CRCFindInPageController {
+  base::WeakPtr<content::WebContents> _webContents;
+  __weak UIView* _view;
+  // The session of the find navigator, while it shows.
+  CRCFindSession* _session;
+}
+
+- (instancetype)initWithWebContents:(content::WebContents*)webContents
+                               view:(UIView*)view {
+  self = [super init];
+  if (self) {
+    _webContents = webContents->GetWeakPtr();
+    _view = view;
+    _findInteraction = [[UIFindInteraction alloc] initWithSessionDelegate:self];
+    // Blink finds substrings only, so there is no Whole Words option.
+    _findInteraction.optionsMenuProvider =
+        ^UIMenu*(NSArray<UIMenuElement*>* defaultOptions) {
+          NSMutableArray<UIMenuElement*>* options = [NSMutableArray array];
+          for (UIMenuElement* option in defaultOptions) {
+            UIAction* action = base::apple::ObjCCast<UIAction>(option);
+            if (![action.identifier isEqualToString:@"wholeWords"]) {
+              [options addObject:option];
+            }
+          }
+          return [UIMenu menuWithChildren:options];
+        };
+    [view addInteraction:_findInteraction];
+  }
+  return self;
+}
+
+- (void)didReceiveFindReplyForRequest:(int)requestID
+                      numberOfMatches:(int)numberOfMatches
+                   activeMatchOrdinal:(int)activeMatchOrdinal {
+  [_session didReceiveFindReplyForRequest:requestID
+                          numberOfMatches:numberOfMatches
+                       activeMatchOrdinal:activeMatchOrdinal];
+}
+
+- (void)detach {
+  [_findInteraction dismissFindNavigator];
+  [_view removeInteraction:_findInteraction];
+}
+
+#pragma mark - UIFindInteractionDelegate
+
+- (UIFindSession*)findInteraction:(UIFindInteraction*)interaction
+                   sessionForView:(UIView*)view {
+  _session = [[CRCFindSession alloc] initWithWebContents:_webContents
+                                             interaction:interaction];
+  return _session;
+}
+
+- (void)findInteraction:(UIFindInteraction*)interaction
+      didEndFindSession:(UIFindSession*)session {
+  if (session == _session) {
+    _session = nil;
+  }
+}
+
+@end
