diff --git a/ios/web/content/content_permission_manager.h b/ios/web/content/content_permission_manager.h
new file mode 100644
index 0000000000000000000000000000000000000000..6a4d0a7fcfa39764deb3c0860407711bd2cc5a3e
--- /dev/null
+++ b/ios/web/content/content_permission_manager.h
@@ -0,0 +1,86 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_CONTENT_PERMISSION_MANAGER_H_
+#define IOS_WEB_CONTENT_CONTENT_PERMISSION_MANAGER_H_
+
+#include <map>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/permission_controller_delegate.h"
+#include "url/origin.h"
+
+namespace web {
+
+// [ios-blink-sideload] Site permissions for Blink. The browser context had no
+// permission delegate, so content denied every request without asking, even
+// writing to the clipboard. As in Chrome, writing to the clipboard is allowed,
+// and a site has to ask for the location and for reading the clipboard, with
+// an alert; the answer lasts for the site until the app quits. The camera and
+// the microphone are asked for with the media request (see
+// ContentWebState::RequestMediaAccessPermission()), so here they stay at
+// "ask". Everything else is denied, as before.
+class ContentPermissionManager : public content::PermissionControllerDelegate {
+ public:
+  ContentPermissionManager();
+  ContentPermissionManager(const ContentPermissionManager&) = delete;
+  ContentPermissionManager& operator=(const ContentPermissionManager&) = delete;
+  ~ContentPermissionManager() override;
+
+  // content::PermissionControllerDelegate:
+  void RequestPermissionsFromCurrentDocument(
+      content::RenderFrameHost* render_frame_host,
+      const content::PermissionRequestDescription& request_description,
+      base::OnceCallback<void(const std::vector<content::PermissionResult>&)>
+          callback) override;
+  blink::mojom::PermissionStatus GetPermissionStatus(
+      const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+      const GURL& requesting_origin,
+      const GURL& embedding_origin) override;
+  content::PermissionResult GetPermissionResultForOriginWithoutContext(
+      const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+      const url::Origin& requesting_origin,
+      const url::Origin& embedding_origin) override;
+  content::PermissionResult GetPermissionResultForCurrentDocument(
+      const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+      content::RenderFrameHost* render_frame_host,
+      bool should_include_device_status) override;
+  content::PermissionResult GetPermissionResultForWorker(
+      const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+      content::RenderProcessHost* render_process_host,
+      const GURL& worker_origin) override;
+  content::PermissionResult GetPermissionResultForEmbeddedRequester(
+      const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+      content::RenderFrameHost* render_frame_host,
+      const url::Origin& requesting_origin) override;
+  void ResetPermission(blink::PermissionType permission,
+                       const GURL& requesting_origin,
+                       const GURL& embedding_origin) override;
+
+ private:
+  struct Request;
+
+  // The status of `type` for the site at `origin` (the main frame's).
+  blink::mojom::PermissionStatus GetStatus(blink::PermissionType type,
+                                           const url::Origin& origin) const;
+
+  // Asks for the first permission of the request that still needs an answer,
+  // or answers the request when none does.
+  void PromptNext(int request_id);
+  void OnPromptAnswered(int request_id,
+                        blink::PermissionType type,
+                        bool granted);
+
+  std::map<std::pair<blink::PermissionType, url::Origin>, bool> decisions_;
+  std::map<int, std::unique_ptr<Request>> requests_;
+  int next_request_id_ = 0;
+  base::WeakPtrFactory<ContentPermissionManager> weak_factory_{this};
+};
+
+}  // namespace web
+
+#endif  // IOS_WEB_CONTENT_CONTENT_PERMISSION_MANAGER_H_
diff --git a/ios/web/content/content_permission_manager.mm b/ios/web/content/content_permission_manager.mm
new file mode 100644
index 0000000000000000000000000000000000000000..fa2a10a2676a2971c75233beffe94c8ccf837d65
--- /dev/null
+++ b/ios/web/content/content_permission_manager.mm
@@ -0,0 +1,265 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/content_permission_manager.h"
+
+#import <UIKit/UIKit.h>
+
+#import <algorithm>
+
+#import "base/strings/sys_string_conversions.h"
+#import "components/strings/grit/components_strings.h"
+#import "components/url_formatter/elide_url.h"
+#import "content/public/browser/permission_request_description.h"
+#import "content/public/browser/permission_result.h"
+#import "content/public/browser/render_frame_host.h"
+#import "content/public/browser/visibility.h"
+#import "content/public/browser/web_contents.h"
+#import "third_party/blink/public/common/permissions/permission_utils.h"
+#import "ui/base/l10n/l10n_util.h"
+#import "ui/base/l10n/l10n_util_mac.h"
+
+namespace web {
+
+namespace {
+
+using blink::mojom::PermissionStatus;
+
+// The alert asking for `type`, for the types this manager asks for itself.
+std::optional<int> PromptMessageId(blink::PermissionType type) {
+  switch (type) {
+    case blink::PermissionType::GEOLOCATION:
+      return IDS_GEOLOCATION_INFOBAR_TEXT;
+    case blink::PermissionType::CLIPBOARD_READ_WRITE:
+      return IDS_CLIPBOARD_INFOBAR_TEXT;
+    default:
+      return std::nullopt;
+  }
+}
+
+// Permissions are kept for the site in the main frame, which the prompt names.
+url::Origin SiteOrigin(content::RenderFrameHost* render_frame_host) {
+  return render_frame_host->GetMainFrame()->GetLastCommittedOrigin();
+}
+
+// The view controller to present an alert from, above anything presented.
+UIViewController* TopViewController(UIView* view) {
+  UIViewController* controller = view.window.rootViewController;
+  while (controller.presentedViewController &&
+         !controller.presentedViewController.beingDismissed) {
+    controller = controller.presentedViewController;
+  }
+  return controller;
+}
+
+}  // namespace
+
+struct ContentPermissionManager::Request {
+  url::Origin origin;
+  base::WeakPtr<content::WebContents> web_contents;
+  std::vector<blink::PermissionType> types;
+  std::vector<PermissionStatus> statuses;
+  base::OnceCallback<void(const std::vector<content::PermissionResult>&)>
+      callback;
+};
+
+ContentPermissionManager::ContentPermissionManager() = default;
+
+ContentPermissionManager::~ContentPermissionManager() = default;
+
+PermissionStatus ContentPermissionManager::GetStatus(
+    blink::PermissionType type,
+    const url::Origin& origin) const {
+  switch (type) {
+    case blink::PermissionType::CLIPBOARD_SANITIZED_WRITE:
+      return PermissionStatus::GRANTED;
+    case blink::PermissionType::GEOLOCATION:
+    case blink::PermissionType::CLIPBOARD_READ_WRITE: {
+      auto it = decisions_.find({type, origin});
+      if (it == decisions_.end()) {
+        return PermissionStatus::ASK;
+      }
+      return it->second ? PermissionStatus::GRANTED : PermissionStatus::DENIED;
+    }
+    case blink::PermissionType::AUDIO_CAPTURE:
+    case blink::PermissionType::VIDEO_CAPTURE:
+      return PermissionStatus::ASK;
+    default:
+      return PermissionStatus::DENIED;
+  }
+}
+
+void ContentPermissionManager::RequestPermissionsFromCurrentDocument(
+    content::RenderFrameHost* render_frame_host,
+    const content::PermissionRequestDescription& request_description,
+    base::OnceCallback<void(const std::vector<content::PermissionResult>&)>
+        callback) {
+  auto request = std::make_unique<Request>();
+  request->origin = SiteOrigin(render_frame_host);
+  request->web_contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host)
+          ->GetWeakPtr();
+  request->callback = std::move(callback);
+  for (const auto& permission : request_description.permissions) {
+    blink::PermissionType type =
+        blink::PermissionDescriptorToPermissionType(permission);
+    PermissionStatus status = GetStatus(type, request->origin);
+    // The camera and the microphone are asked for with the media request
+    // (ContentWebState), not here.
+    if (render_frame_host->IsNestedWithinFencedFrame() ||
+        (status == PermissionStatus::ASK && !PromptMessageId(type))) {
+      status = PermissionStatus::DENIED;
+    }
+    request->types.push_back(type);
+    request->statuses.push_back(status);
+  }
+  const int request_id = next_request_id_++;
+  requests_[request_id] = std::move(request);
+  PromptNext(request_id);
+}
+
+void ContentPermissionManager::PromptNext(int request_id) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    return;
+  }
+  Request& request = *it->second;
+  auto ask = std::ranges::find(request.statuses, PermissionStatus::ASK);
+  content::WebContents* web_contents = request.web_contents.get();
+  UIViewController* presenter =
+      web_contents ? TopViewController(web_contents->GetNativeView().Get())
+                   : nil;
+  if (ask == request.statuses.end() || !presenter ||
+      web_contents->GetVisibility() != content::Visibility::VISIBLE) {
+    // Every permission is answered, or there is nowhere to ask: what is still
+    // unanswered is denied.
+    std::vector<content::PermissionResult> results;
+    for (PermissionStatus status : request.statuses) {
+      results.emplace_back(status == PermissionStatus::ASK
+                               ? PermissionStatus::DENIED
+                               : status);
+    }
+    auto callback = std::move(request.callback);
+    requests_.erase(it);
+    std::move(callback).Run(results);
+    return;
+  }
+
+  const blink::PermissionType type =
+      request.types[std::distance(request.statuses.begin(), ask)];
+  NSString* title = base::SysUTF16ToNSString(l10n_util::GetStringFUTF16(
+      *PromptMessageId(type),
+      url_formatter::FormatOriginForSecurityDisplay(
+          request.origin, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS)));
+  UIAlertController* alert =
+      [UIAlertController alertControllerWithTitle:title
+                                          message:nil
+                                   preferredStyle:UIAlertControllerStyleAlert];
+  base::WeakPtr<ContentPermissionManager> weak_this =
+      weak_factory_.GetWeakPtr();
+  [alert addAction:[UIAlertAction
+                       actionWithTitle:l10n_util::GetNSString(
+                                           IDS_PERMISSION_DONT_ALLOW)
+                                 style:UIAlertActionStyleCancel
+                               handler:^(UIAlertAction* action) {
+                                 if (weak_this) {
+                                   weak_this->OnPromptAnswered(request_id, type,
+                                                               false);
+                                 }
+                               }]];
+  [alert addAction:[UIAlertAction
+                       actionWithTitle:l10n_util::GetNSString(
+                                           IDS_PERMISSION_ALLOW)
+                                 style:UIAlertActionStyleDefault
+                               handler:^(UIAlertAction* action) {
+                                 if (weak_this) {
+                                   weak_this->OnPromptAnswered(request_id, type,
+                                                               true);
+                                 }
+                               }]];
+  [presenter presentViewController:alert animated:YES completion:nil];
+}
+
+void ContentPermissionManager::OnPromptAnswered(int request_id,
+                                                blink::PermissionType type,
+                                                bool granted) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    return;
+  }
+  Request& request = *it->second;
+  decisions_[{type, request.origin}] = granted;
+  for (size_t i = 0; i < request.types.size(); ++i) {
+    if (request.types[i] == type &&
+        request.statuses[i] == PermissionStatus::ASK) {
+      request.statuses[i] =
+          granted ? PermissionStatus::GRANTED : PermissionStatus::DENIED;
+    }
+  }
+  PromptNext(request_id);
+}
+
+PermissionStatus ContentPermissionManager::GetPermissionStatus(
+    const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+    const GURL& requesting_origin,
+    const GURL& embedding_origin) {
+  return GetStatus(
+      blink::PermissionDescriptorToPermissionType(permission_descriptor),
+      url::Origin::Create(embedding_origin));
+}
+
+content::PermissionResult
+ContentPermissionManager::GetPermissionResultForOriginWithoutContext(
+    const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+    const url::Origin& requesting_origin,
+    const url::Origin& embedding_origin) {
+  return content::PermissionResult(GetStatus(
+      blink::PermissionDescriptorToPermissionType(permission_descriptor),
+      embedding_origin));
+}
+
+content::PermissionResult
+ContentPermissionManager::GetPermissionResultForCurrentDocument(
+    const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+    content::RenderFrameHost* render_frame_host,
+    bool should_include_device_status) {
+  if (render_frame_host->IsNestedWithinFencedFrame()) {
+    return content::PermissionResult(PermissionStatus::DENIED);
+  }
+  return content::PermissionResult(GetStatus(
+      blink::PermissionDescriptorToPermissionType(permission_descriptor),
+      SiteOrigin(render_frame_host)));
+}
+
+content::PermissionResult
+ContentPermissionManager::GetPermissionResultForWorker(
+    const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+    content::RenderProcessHost* render_process_host,
+    const GURL& worker_origin) {
+  return content::PermissionResult(GetStatus(
+      blink::PermissionDescriptorToPermissionType(permission_descriptor),
+      url::Origin::Create(worker_origin)));
+}
+
+content::PermissionResult
+ContentPermissionManager::GetPermissionResultForEmbeddedRequester(
+    const blink::mojom::PermissionDescriptorPtr& permission_descriptor,
+    content::RenderFrameHost* render_frame_host,
+    const url::Origin& requesting_origin) {
+  if (render_frame_host->IsNestedWithinFencedFrame()) {
+    return content::PermissionResult(PermissionStatus::DENIED);
+  }
+  return content::PermissionResult(GetStatus(
+      blink::PermissionDescriptorToPermissionType(permission_descriptor),
+      SiteOrigin(render_frame_host)));
+}
+
+void ContentPermissionManager::ResetPermission(
+    blink::PermissionType permission,
+    const GURL& requesting_origin,
+    const GURL& embedding_origin) {
+  decisions_.erase({permission, url::Origin::Create(embedding_origin)});
+}
+
+}  // namespace web
