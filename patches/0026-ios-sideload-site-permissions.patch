+// The capture device the page asked for, or the first one.
+const blink::MediaStreamDevice* GetRequestedDeviceOrDefault(
+    const blink::MediaStreamDevices& devices,
+    const std::vector<std::string>& requested_device_ids) {
+  if (!requested_device_ids.empty() && !requested_device_ids.front().empty()) {
+    auto it = std::ranges::find(devices, requested_device_ids.front(),
+                                &blink::MediaStreamDevice::id);
+    return it != devices.end() ? &*it : nullptr;
+  }
+  return devices.empty() ? nullptr : &devices.front();
+}
+
+void RespondToMediaAccessRequest(const content::MediaStreamRequest& request,
+                                 content::MediaResponseCallback callback,
+                                 bool audio_allowed,
+                                 bool video_allowed) {
+  if (!audio_allowed && !video_allowed) {
+    std::move(callback).Run(
+        blink::mojom::StreamDevicesSet(),
+        blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED, nullptr);
+    return;
+  }
+  content::MediaCaptureDevices* capture_devices =
+      content::MediaCaptureDevices::GetInstance();
+  blink::mojom::StreamDevicesSet stream_devices_set;
+  stream_devices_set.stream_devices.emplace_back(
+      blink::mojom::StreamDevices::New());
+  blink::mojom::StreamDevices& devices = *stream_devices_set.stream_devices[0];
+  if (audio_allowed) {
+    if (const blink::MediaStreamDevice* device = GetRequestedDeviceOrDefault(
+            capture_devices->GetAudioCaptureDevices(),
+            request.requested_audio_device_ids)) {
+      devices.audio_device = *device;
+    }
+  }
+  if (video_allowed) {
+    if (const blink::MediaStreamDevice* device = GetRequestedDeviceOrDefault(
+            capture_devices->GetVideoCaptureDevices(),
+            request.requested_video_device_ids)) {
+      devices.video_device = *device;
+    }
+  }
+  if (!devices.audio_device && !devices.video_device) {
+    std::move(callback).Run(blink::mojom::StreamDevicesSet(),
+                            blink::mojom::MediaStreamRequestResult::NO_HARDWARE,
+                            nullptr);
+    return;
+  }
+  std::move(callback).Run(stream_devices_set,
+                          blink::mojom::MediaStreamRequestResult::OK, nullptr);
+}
+
+}  // namespace
+
+void ContentWebState::RequestMediaAccessPermission(
+    content::WebContents* web_contents,
+    const content::MediaStreamRequest& request,
+    content::MediaResponseCallback callback) {
+  // [ios-blink-sideload] Ask for the camera and the microphone with the prompt
+  // the embedder shows for WKWebView
+  // (WebStateDelegate::HandlePermissionsDecisionRequest()); content denied
+  // them. The answer holds until another page shows, as in WebKit.
+  const bool audio =
+      request.audio_type == blink::mojom::MediaStreamType::DEVICE_AUDIO_CAPTURE;
+  const bool video =
+      request.video_type == blink::mojom::MediaStreamType::DEVICE_VIDEO_CAPTURE;
+  if (!audio && !video) {
+    std::move(callback).Run(
+        blink::mojom::StreamDevicesSet(),
+        blink::mojom::MediaStreamRequestResult::NOT_SUPPORTED, nullptr);
+    return;
+  }
+  // What is not requested counts as answered: not allowed.
+  const std::optional<bool> audio_decision =
+      audio ? microphone_allowed_ : std::optional<bool>(false);
+  const std::optional<bool> video_decision =
+      video ? camera_allowed_ : std::optional<bool>(false);
+  if ((audio_decision && video_decision) || !delegate_) {
+    RespondToMediaAccessRequest(request, std::move(callback),
+                                audio_decision.value_or(false),
+                                video_decision.value_or(false));
+    return;
+  }
+
+  NSMutableArray<NSNumber*>* asked = [NSMutableArray array];
+  if (!video_decision) {
+    [asked addObject:@(PermissionCamera)];
+  }
+  if (!audio_decision) {
+    [asked addObject:@(PermissionMicrophone)];
+  }
+  auto shared_callback =
+      std::make_shared<content::MediaResponseCallback>(std::move(callback));
+  base::WeakPtr<ContentWebState> weak_this = weak_factory_.GetWeakPtr();
+  const content::MediaStreamRequest request_copy = request;
+  delegate_->HandlePermissionsDecisionRequest(
+      this, asked, ^(PermissionDecision decision) {
+        const bool granted = decision == PermissionDecisionGrant;
+        if (weak_this) {
+          if (!video_decision) {
+            weak_this->camera_allowed_ = granted;
+          }
+          if (!audio_decision) {
+            weak_this->microphone_allowed_ = granted;
+          }
+        }
+        RespondToMediaAccessRequest(request_copy, std::move(*shared_callback),
+                                    audio_decision.value_or(granted),
+                                    video_decision.value_or(granted));
+      });
+}
+
+bool ContentWebState::CheckMediaAccessPermission(
+    content::RenderFrameHost* render_frame_host,
+    const url::Origin& security_origin,
+    blink::mojom::MediaStreamType type) {
+  // [ios-blink-sideload] See RequestMediaAccessPermission().
+  return (type == blink::mojom::MediaStreamType::DEVICE_AUDIO_CAPTURE
+              ? microphone_allowed_
+              : camera_allowed_)
+      .value_or(false);
+}
