+void ChromeWebClient::RunFileChooser(
+    web::WebState* source,
+    bool allow_multiple_files,
+    bool only_allow_directory,
+    bool has_selected_file,
+    const std::vector<std::string>& accept_mime_types,
+    const std::vector<std::string>& accept_file_extensions,
+    bool capture,
+    base::OnceCallback<void(NSArray<NSURL*>*)> completion) const {
+  // [ios-blink-sideload] The Blink port's file inputs get the same panel as
+  // WebKit's: photo library, camera or files, depending on what they accept.
+  ChooseFileTabHelper* tab_helper = ChooseFileTabHelper::FromWebState(source);
+  CHECK(tab_helper);
+  // Blink only says whether the input has a capture attribute, not which
+  // camera it asks for: use the one on the back.
+  tab_helper->RunFileChooser(
+      ChooseFileEvent::Builder()
+          .SetWebState(source)
+          .SetAllowMultipleFiles(allow_multiple_files)
+          .SetOnlyAllowDirectory(only_allow_directory)
+          .SetHasSelectedFile(has_selected_file)
+          .SetAcceptMimeTypes(accept_mime_types)
+          .SetAcceptFileExtensions(accept_file_extensions)
+          .SetCapture(capture ? ChooseFileCaptureType::kEnvironment
+                              : ChooseFileCaptureType::kNone)
+          .Build(),
+      std::move(completion));
+}
