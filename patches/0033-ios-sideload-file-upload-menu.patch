-// contains 'Photo Library', 'Take Photo', and 'Choose File' sub menus as
-// browsers based on WebKit.
+namespace {
+
+// [ios-blink-sideload] Gives the page the files chosen in Chrome's file upload
+// panel (see RunFileChooser()).
+void FilesChosen(scoped_refptr<content::FileSelectListener> listener,
+                 blink::mojom::FileChooserParams::Mode mode,
+                 NSArray<NSURL*>* file_urls) {
+  std::vector<blink::mojom::FileChooserFileInfoPtr> files;
+  for (NSURL* url in file_urls) {
+    if (url.fileURL) {
+      files.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+          blink::mojom::NativeFileInfo::New(base::apple::NSURLToFilePath(url),
+                                            std::u16string(),
+                                            std::vector<std::u16string>())));
+    }
+  }
+  if (files.empty()) {
+    listener->FileSelectionCanceled();
+    return;
+  }
+  listener->FileSelected(std::move(files), base::FilePath(), mode);
+}
+
+}  // namespace
+
 void ContentWebState::RunFileChooser(
     content::RenderFrameHost* render_frame_host,
     scoped_refptr<content::FileSelectListener> listener,
     const blink::mojom::FileChooserParams& params) {
+  // [ios-blink-sideload] Show Chrome's file upload panel, as WKWebView does
+  // (crbug.com/40255112): like Safari, it offers the photo library, the camera
+  // and Files, depending on what the input accepts, where content went
+  // straight to Files. Folders and saving still go to the system's document
+  // picker.
+  using Mode = blink::mojom::FileChooserParams::Mode;
+  if ((params.mode == Mode::kOpen || params.mode == Mode::kOpenMultiple) &&
+      GetWebClient()->CanRunOpenPanel(this)) {
+    // Blink gives the accept attribute's lowercase MIME types and extensions
+    // (with their leading dot) together.
+    std::vector<std::string> accept_mime_types;
+    std::vector<std::string> accept_file_extensions;
+    for (const std::u16string& accept_type : params.accept_types) {
+      std::string type = base::UTF16ToUTF8(accept_type);
+      if (type.starts_with('.')) {
+        accept_file_extensions.push_back(std::move(type));
+      } else if (!type.empty()) {
+        accept_mime_types.push_back(std::move(type));
+      }
+    }
+    GetWebClient()->RunFileChooser(
+        this, params.mode == Mode::kOpenMultiple,
+        /*only_allow_directory=*/false,
+        /*has_selected_file=*/!params.selected_files.empty(),
+        accept_mime_types, accept_file_extensions, params.use_media_capture,
+        base::BindOnce(&FilesChosen, std::move(listener), params.mode));
+    return;
+  }
   web_contents_delegate_ios::FileSelectHelperIOS::RunFileChooser(
       render_frame_host, listener, params);
 }
