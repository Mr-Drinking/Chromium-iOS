From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ios-blink-sideload <noreply@example.invalid>
Date: Tue, 27 Oct 2026 15:59:47 +0800
Subject: [PATCH] iOS sideload: show the system edit menu for text

Long-pressing text in a page selected a word and nothing else, so there
was no way to copy text with touch: Blink asks for a context menu, but
ContentContextMenuController only shows the embedder's menu, and Chrome
builds menus for links and images only.

When a context menu request has no link and no image but has selected
text or comes from a text field, present the system edit menu for the
selection instead, the one Safari shows, through the web view's
BrowserEngineKit text interaction. The web view decides which actions
the menu offers and runs them (see patch 0019), and the menu is not a
Blink context menu, so tell Blink this one is closed.

Status: verified at Chromium 4558926c in the iOS 27 simulator, with
patch 0019: a long press on a word of text shows Copy, Look Up and
Translate (Share on the second page) over the selection; in a text
field, Cut, Copy, Paste and Select All. A long press on a link still
shows Chrome's link menu.

diff --git a/ios/web/content/BUILD.gn b/ios/web/content/BUILD.gn
index a2eff5aae23202f334ea0ec4338288b0cb4c80e8..127a07e2adfdf93edbb2d2638a95f14fafef2ff6 100644
--- a/ios/web/content/BUILD.gn
+++ b/ios/web/content/BUILD.gn
@@ -110,6 +110,7 @@ source_set("ui") {
     "//ios/web/public",
     "//ios/web/public/ui",
   ]
+  frameworks = [ "BrowserEngineKit.framework" ]
 }
 
 test("ios_web_content_unittests") {
diff --git a/ios/web/content/ui/content_context_menu_controller.mm b/ios/web/content/ui/content_context_menu_controller.mm
index 3cfe9e543aa48a1d4bbe9a5e5a0687601008bb59..1bdca76040d9b85d47518c21441ab81703573461 100644
--- a/ios/web/content/ui/content_context_menu_controller.mm
+++ b/ios/web/content/ui/content_context_menu_controller.mm
@@ -4,6 +4,7 @@
 
 #import "ios/web/content/ui/content_context_menu_controller.h"
 
+#import <BrowserEngineKit/BrowserEngineKit.h>
 #import <UIKit/UIKit.h>
 
 #import "base/apple/foundation_util.h"
@@ -138,6 +139,28 @@ - (void)contextMenuInteraction:(UIContextMenuInteraction*)interaction
 
 namespace {
 
+// [ios-blink-sideload] Whether `params` asks for a menu for text, rather than
+// for a link or an image.
+bool IsEditMenuRequest(const content::ContextMenuParams& params) {
+  return params.link_url.is_empty() && params.src_url.is_empty() &&
+         (params.is_editable || !params.selection_text.empty());
+}
+
+// [ios-blink-sideload] Shows the system edit menu, the one Safari shows, for
+// the selection in the web view `view`: Blink asks for a context menu when text
+// or a text field is long-pressed, but Chrome only builds context menus for
+// links and images. The view's text interaction asks the view which actions
+// to offer, and sends them to it.
+void PresentEditMenu(UIView* view) {
+  for (id<UIInteraction> interaction in view.interactions) {
+    if (BETextInteraction* text_interaction =
+            base::apple::ObjCCast<BETextInteraction>(interaction)) {
+      [text_interaction presentEditMenuForSelection];
+      return;
+    }
+  }
+}
+
 gfx::NativeView GetContentNativeView(content::WebContents* web_contents) {
   content::RenderWidgetHostView* rwhv = web_contents->GetRenderWidgetHostView();
   if (!rwhv) {
@@ -167,6 +190,12 @@ - (void)contextMenuInteraction:(UIContextMenuInteraction*)interaction
 
   UIView* view = base::apple::ObjCCastStrict<UIView>(
       GetContentNativeView(web_contents).Get());
+  if (view && IsEditMenuRequest(params)) {
+    PresentEditMenu(view);
+    // The edit menu is not a Blink context menu, so this one is done.
+    web_contents->NotifyContextMenuClosed(GURL());
+    return;
+  }
   CGRect frame = CGRectMake(params.x, params.y, 0, 0);
 
   [hidden_button_->button_ removeFromSuperview];
