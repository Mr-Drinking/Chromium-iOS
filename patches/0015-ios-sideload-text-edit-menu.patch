 // A hidden button used only for creating context menus. The only way to
 // programmatically trigger a context menu on iOS is to trigger the primary
@@ -136,8 +138,132 @@ - (void)contextMenuInteraction:(UIContextMenuInteraction*)interaction
 
 @end
 
+// [ios-blink-sideload] The system edit menu (Cut, Copy, Paste, Select All) for
+// a context menu request without a link or an image, which Blink sends when
+// text or a text field is long-pressed: Chrome only builds context menus for
+// links and images. The menu's actions go through the responder chain to the
+// RenderWidgetUIView, which runs them as Blink edit commands.
+@interface ContentEditMenu : NSObject <UIEditMenuInteractionDelegate>
+
+// Shows the menu in `view`, at the location in `params`.
++ (void)showForParams:(const content::ContextMenuParams&)params
+          webContents:(content::WebContents*)webContents
+               inView:(UIView*)view;
+
+@end
+
+namespace {
+
+// Key of the ContentEditMenu associated with a view.
+const char kContentEditMenuKey = 0;
+
+}  // namespace
+
+@implementation ContentEditMenu {
+  UIEditMenuInteraction* _interaction;
+  int _editFlags;
+  // The selection, for the menu to avoid, or CGRectNull.
+  CGRect _selectionRect;
+  base::WeakPtr<content::WebContents> _webContents;
+}
+
++ (void)showForParams:(const content::ContextMenuParams&)params
+          webContents:(content::WebContents*)webContents
+               inView:(UIView*)view {
+  // A view keeps one menu, and the menu its interaction.
+  ContentEditMenu* menu = objc_getAssociatedObject(view, &kContentEditMenuKey);
+  if (!menu) {
+    menu = [[ContentEditMenu alloc] init];
+    menu->_interaction = [[UIEditMenuInteraction alloc] initWithDelegate:menu];
+    [view addInteraction:menu->_interaction];
+    objc_setAssociatedObject(view, &kContentEditMenuKey, menu,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  }
+  menu->_editFlags = params.edit_flags;
+  // A subframe's selection rect is in that frame's coordinates.
+  menu->_selectionRect = params.is_subframe || params.selection_rect.IsEmpty()
+                             ? CGRectNull
+                             : params.selection_rect.ToCGRect();
+  menu->_webContents = webContents->GetWeakPtr();
+  UIEditMenuConfiguration* configuration = [UIEditMenuConfiguration
+      configurationWithIdentifier:nil
+                      sourcePoint:CGPointMake(params.x, params.y)];
+  // Above the selection where there is room, like UIKit's text views.
+  configuration.preferredArrowDirection = UIEditMenuArrowDirectionDown;
+  [menu->_interaction presentEditMenuWithConfiguration:configuration];
+}
+
+// Whether the menu offers the standard edit `action`.
+- (BOOL)allowsAction:(SEL)action {
+  if (action == @selector(cut:)) {
+    return (_editFlags & blink::kCanCut) != 0;
+  }
+  if (action == @selector(copy:)) {
+    return (_editFlags & blink::kCanCopy) != 0;
+  }
+  if (action == @selector(paste:)) {
+    return (_editFlags & blink::kCanPaste) != 0 &&
+           UIPasteboard.generalPasteboard.hasStrings;
+  }
+  if (action == @selector(selectAll:)) {
+    return (_editFlags & blink::kCanSelectAll) != 0;
+  }
+  return NO;
+}
+
+// Returns the commands of `elements` that the menu offers, in their submenus.
+- (NSArray<UIMenuElement*>*)allowedElements:
+    (NSArray<UIMenuElement*>*)elements {
+  NSMutableArray<UIMenuElement*>* allowed = [NSMutableArray array];
+  for (UIMenuElement* element in elements) {
+    if (UIMenu* menu = base::apple::ObjCCast<UIMenu>(element)) {
+      NSArray<UIMenuElement*>* children = [self allowedElements:menu.children];
+      if (children.count) {
+        [allowed addObject:[menu menuByReplacingChildren:children]];
+      }
+    } else if (UICommand* command = base::apple::ObjCCast<UICommand>(element)) {
+      if ([self allowsAction:command.action]) {
+        [allowed addObject:command];
+      }
+    }
+  }
+  return allowed;
+}
+
+#pragma mark - UIEditMenuInteractionDelegate
+
+- (UIMenu*)editMenuInteraction:(UIEditMenuInteraction*)interaction
+          menuForConfiguration:(UIEditMenuConfiguration*)configuration
+              suggestedActions:(NSArray<UIMenuElement*>*)suggestedActions {
+  NSArray<UIMenuElement*>* children = [self allowedElements:suggestedActions];
+  return children.count ? [UIMenu menuWithChildren:children] : nil;
+}
+
+- (CGRect)editMenuInteraction:(UIEditMenuInteraction*)interaction
+    targetRectForConfiguration:(UIEditMenuConfiguration*)configuration {
+  return _selectionRect;
+}
+
+- (void)editMenuInteraction:(UIEditMenuInteraction*)interaction
+    willDismissMenuForConfiguration:(UIEditMenuConfiguration*)configuration
+                           animator:
+                               (id<UIEditMenuInteractionAnimating>)animator {
+  if (_webContents) {
+    _webContents->NotifyContextMenuClosed(GURL());
+  }
+}
+
+@end
+
 namespace {
 
+// [ios-blink-sideload] Whether `params` asks for a menu for text, rather than
+// for a link or an image.
+bool IsEditMenuRequest(const content::ContextMenuParams& params) {
+  return params.link_url.is_empty() && params.src_url.is_empty() &&
+         (params.is_editable || !params.selection_text.empty());
+}
+
 gfx::NativeView GetContentNativeView(content::WebContents* web_contents) {
   content::RenderWidgetHostView* rwhv = web_contents->GetRenderWidgetHostView();
   if (!rwhv) {
@@ -167,6 +293,10 @@ - (void)contextMenuInteraction:(UIContextMenuInteraction*)interaction
 
   UIView* view = base::apple::ObjCCastStrict<UIView>(
       GetContentNativeView(web_contents).Get());
+  if (view && IsEditMenuRequest(params)) {
+    [ContentEditMenu showForParams:params webContents:web_contents inView:view];
+    return;
+  }
   CGRect frame = CGRectMake(params.x, params.y, 0, 0);
 
   [hidden_button_->button_ removeFromSuperview];
