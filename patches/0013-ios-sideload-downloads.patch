+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_MANAGER_DELEGATE_H_
+#define IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_MANAGER_DELEGATE_H_
+
+#import <cstdint>
+
+#import "base/memory/raw_ptr.h"
+#import "base/memory/scoped_refptr.h"
+#import "content/public/browser/download_manager_delegate.h"
+
+namespace base {
+class SequencedTaskRunner;
+}  // namespace base
+
+namespace content {
+class DownloadManager;
+}  // namespace content
+
+namespace web {
+
+class BrowserState;
+
+// [ios-blink-sideload] Hands every download that content (Blink) starts to
+// Chrome's download UI (web::DownloadController) as a ContentDownloadTask.
+// Without a delegate, content dropped downloads silently.
+class ContentDownloadManagerDelegate : public content::DownloadManagerDelegate {
+ public:
+  explicit ContentDownloadManagerDelegate(BrowserState* browser_state);
+
+  ContentDownloadManagerDelegate(const ContentDownloadManagerDelegate&) =
+      delete;
+  ContentDownloadManagerDelegate& operator=(
+      const ContentDownloadManagerDelegate&) = delete;
+
+  ~ContentDownloadManagerDelegate() override;
+
+  // Sets the download manager that uses this delegate. The manager outlives
+  // the delegate, so the delegate detaches itself from it when destroyed.
+  void SetDownloadManager(content::DownloadManager* download_manager);
+
+  // content::DownloadManagerDelegate:
+  void Shutdown() override;
+  void GetNextId(content::DownloadIdCallback callback) override;
+  bool DetermineDownloadTarget(
+      ::download::DownloadItem* item,
+      ::download::DownloadTargetCallback* callback) override;
+
+ private:
+  raw_ptr<BrowserState> browser_state_;
+  raw_ptr<content::DownloadManager> download_manager_ = nullptr;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  uint32_t next_id_;
+};
+
+}  // namespace web
+
+#endif  // IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_MANAGER_DELEGATE_H_
diff --git a/ios/web/content/download/content_download_manager_delegate.mm b/ios/web/content/download/content_download_manager_delegate.mm
new file mode 100644
index 0000000000000000000000000000000000000000..e58f2838665850577dcda87109e438e5f482eadf
--- /dev/null
+++ b/ios/web/content/download/content_download_manager_delegate.mm
@@ -0,0 +1,85 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/download/content_download_manager_delegate.h"
+
+#import <memory>
+#import <utility>
+
+#import "base/task/thread_pool.h"
+#import "components/download/public/common/download_item.h"
+#import "components/download/public/common/download_target_info.h"
+#import "content/public/browser/download_item_utils.h"
+#import "content/public/browser/download_manager.h"
+#import "content/public/browser/web_contents.h"
+#import "ios/web/content/download/content_download_task.h"
+#import "ios/web/content/web_state/content_web_state.h"
+#import "ios/web/download/download_controller_impl.h"
+
+namespace web {
+
+ContentDownloadManagerDelegate::ContentDownloadManagerDelegate(
+    BrowserState* browser_state)
+    : browser_state_(browser_state),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})),
+      next_id_(::download::DownloadItem::kInvalidId + 1) {}
+
+ContentDownloadManagerDelegate::~ContentDownloadManagerDelegate() {
+  // content::BrowserContext shuts the download manager down after
+  // ContentBrowserContext has destroyed this delegate.
+  if (download_manager_) {
+    download_manager_->SetDelegate(nullptr);
+  }
+}
+
+void ContentDownloadManagerDelegate::SetDownloadManager(
+    content::DownloadManager* download_manager) {
+  download_manager_ = download_manager;
+}
+
+void ContentDownloadManagerDelegate::Shutdown() {
+  download_manager_ = nullptr;
+}
+
+void ContentDownloadManagerDelegate::GetNextId(
+    content::DownloadIdCallback callback) {
+  std::move(callback).Run(next_id_++);
+}
+
+bool ContentDownloadManagerDelegate::DetermineDownloadTarget(
+    ::download::DownloadItem* item,
+    ::download::DownloadTargetCallback* callback) {
+  // A forced path needs no UI.
+  if (!item->GetForcedFilePath().empty()) {
+    ::download::DownloadTargetInfo target_info;
+    target_info.target_path = item->GetForcedFilePath();
+    target_info.intermediate_path = item->GetForcedFilePath();
+    std::move(*callback).Run(std::move(target_info));
+    return true;
+  }
+
+  // Every WebContents in ios/web/content is created by a ContentWebState,
+  // which is also its delegate.
+  content::WebContents* web_contents =
+      content::DownloadItemUtils::GetWebContents(item);
+  WebState* web_state =
+      web_contents && web_contents->GetDelegate()
+          ? static_cast<ContentWebState*>(web_contents->GetDelegate())
+          : nullptr;
+  auto* controller = static_cast<DownloadControllerImpl*>(
+      DownloadController::FromBrowserState(browser_state_));
+  if (!web_state || !controller->GetDelegate()) {
+    // Nowhere to show the download: an empty target cancels it.
+    std::move(*callback).Run(::download::DownloadTargetInfo());
+    return true;
+  }
+
+  controller->OnContentDownloadCreated(std::make_unique<ContentDownloadTask>(
+      web_state, item, std::move(*callback), task_runner_));
+  return true;
+}
+
+}  // namespace web
diff --git a/ios/web/content/download/content_download_task.h b/ios/web/content/download/content_download_task.h
new file mode 100644
index 0000000000000000000000000000000000000000..f8362aa54f1ca9d3269579a3aa75a84296b7747b
--- /dev/null
+++ b/ios/web/content/download/content_download_task.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_TASK_H_
+#define IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_TASK_H_
+
+#import <string>
+
+#import "base/functional/callback.h"
+#import "base/memory/raw_ptr.h"
+#import "base/memory/scoped_refptr.h"
+#import "components/download/public/common/download_item.h"
+#import "components/download/public/common/download_target_info.h"
+#import "ios/web/download/download_task_impl.h"
+
+namespace base {
+class SequencedTaskRunner;
+}  // namespace base
+
+namespace web {
+
+class WebState;
+
+// [ios-blink-sideload] A web::DownloadTask for a download that content (Blink)
+// started, so that Chrome's download UI can show and run it. Content fetches
+// the data; this task tells content where to save it once Chrome has picked a
+// path, and reports content's progress back to Chrome.
+class ContentDownloadTask final : public DownloadTaskImpl,
+                                  public ::download::DownloadItem::Observer {
+ public:
+  // `target_callback` is the callback content handed to
+  // DownloadManagerDelegate::DetermineDownloadTarget() for `item`.
+  ContentDownloadTask(
+      WebState* web_state,
+      ::download::DownloadItem* item,
+      ::download::DownloadTargetCallback target_callback,
+      const scoped_refptr<base::SequencedTaskRunner>& task_runner);
+
+  ContentDownloadTask(const ContentDownloadTask&) = delete;
+  ContentDownloadTask& operator=(const ContentDownloadTask&) = delete;
+
+  ~ContentDownloadTask() final;
+
+  // ::download::DownloadItem::Observer:
+  void OnDownloadUpdated(::download::DownloadItem* item) final;
+  void OnDownloadDestroyed(::download::DownloadItem* item) final;
+
+ private:
+  // DownloadTaskImpl:
+  void StartInternal(const base::FilePath& path) final;
+  void CancelInternal() final;
+  std::string GetSuggestedName() const final;
+
+  // Runs `target_callback_` if it has not run yet, with `path` as the target.
+  // An empty `path` makes content cancel the download.
+  void RunTargetCallback(const base::FilePath& path);
+
+  raw_ptr<::download::DownloadItem> item_;
+  ::download::DownloadTargetCallback target_callback_;
+  std::string suggested_name_;
+};
+
+}  // namespace web
+
+#endif  // IOS_WEB_CONTENT_DOWNLOAD_CONTENT_DOWNLOAD_TASK_H_
diff --git a/ios/web/content/download/content_download_task.mm b/ios/web/content/download/content_download_task.mm
new file mode 100644
index 0000000000000000000000000000000000000000..e0a513b5e0ae115656aac56db304bff28379d65f
--- /dev/null
+++ b/ios/web/content/download/content_download_task.mm
@@ -0,0 +1,152 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/web/content/download/content_download_task.h"
+
+#import <Foundation/Foundation.h>
+
+#import "base/strings/sys_string_conversions.h"
+#import "base/task/sequenced_task_runner.h"
+#import "ios/web/download/download_result.h"
+#import "net/base/net_errors.h"
+
+namespace web {
+
+namespace {
+
+// The host of the page that started the download, for Chrome's download UI.
+NSString* OriginatingHostForItem(::download::DownloadItem* item) {
+  const GURL& url =
+      item->GetTabUrl().is_valid() ? item->GetTabUrl() : item->GetURL();
+  return base::SysUTF8ToNSString(url.GetHost());
+}
+
+}  // namespace
+
+ContentDownloadTask::ContentDownloadTask(
+    WebState* web_state,
+    ::download::DownloadItem* item,
+    ::download::DownloadTargetCallback target_callback,
+    const scoped_refptr<base::SequencedTaskRunner>& task_runner)
+    : DownloadTaskImpl(web_state,
+                       item->GetURL(),
+                       OriginatingHostForItem(item),
+                       @"GET",
+                       item->GetContentDisposition(),
+                       item->GetTotalBytes() > 0 ? item->GetTotalBytes() : -1,
+                       item->GetMimeType(),
+                       [[NSUUID UUID] UUIDString],
+                       task_runner),
+      item_(item),
+      target_callback_(std::move(target_callback)),
+      suggested_name_(item->GetSuggestedFilename()) {
+  item_->AddObserver(this);
+}
+
+ContentDownloadTask::~ContentDownloadTask() {
+  // Stop observing first: Chrome is destroying this task, so content's
+  // reaction to the cancellation below must not reach Chrome through it.
+  if (item_) {
+    item_->RemoveObserver(this);
+  }
+  // Chrome dropped the task (the user dismissed it, or a policy refused it)
+  // or the download is still running: make content cancel it.
+  if (target_callback_) {
+    RunTargetCallback(base::FilePath());
+  } else if (item_ &&
+             item_->GetState() == ::download::DownloadItem::IN_PROGRESS) {
+    item_->Cancel(/*user_cancel=*/true);
+  }
+}
+
+void ContentDownloadTask::OnDownloadUpdated(::download::DownloadItem* item) {
+  DCHECK_EQ(item, item_);
+  // Before Chrome starts the task, content may already be fetching data; the
+  // task only reports progress once it is running.
+  if (state_ != State::kInProgress) {
+    return;
+  }
+
+  received_bytes_ = item->GetReceivedBytes();
+  if (item->GetTotalBytes() > 0) {
+    total_bytes_ = item->GetTotalBytes();
+  }
+  percent_complete_ = item->PercentComplete();
+
+  switch (item->GetState()) {
+    case ::download::DownloadItem::IN_PROGRESS:
+      DownloadTaskImpl::OnDownloadUpdated();
+      break;
+    case ::download::DownloadItem::COMPLETE:
+      percent_complete_ = 100;
+      OnDownloadFinished(DownloadResult(net::OK));
+      break;
+    case ::download::DownloadItem::CANCELLED:
+      OnDownloadFinished(DownloadResult(net::ERR_ABORTED, /*can_retry=*/false));
+      break;
+    case ::download::DownloadItem::INTERRUPTED:
+      // Retrying would mean restarting content's download to a new path, which
+      // this task does not do.
+      OnDownloadFinished(DownloadResult(net::ERR_FAILED, /*can_retry=*/false));
+      break;
+    case ::download::DownloadItem::MAX_DOWNLOAD_STATE:
+      NOTREACHED();
+  }
+}
+
+void ContentDownloadTask::OnDownloadDestroyed(::download::DownloadItem* item) {
+  DCHECK_EQ(item, item_);
+  item_->RemoveObserver(this);
+  item_ = nullptr;
+  if (state_ == State::kInProgress) {
+    OnDownloadFinished(DownloadResult(net::ERR_ABORTED, /*can_retry=*/false));
+  }
+}
+
+void ContentDownloadTask::StartInternal(const base::FilePath& path) {
+  if (!item_ || !target_callback_) {
+    // Content has dropped the download, or this is a retry: the target was
+    // already handed to content and cannot change.
+    OnDownloadFinished(DownloadResult(net::ERR_FAILED, /*can_retry=*/false));
+    return;
+  }
+  RunTargetCallback(path);
+  if (item_) {
+    // Report what content has already fetched (or a quick completion).
+    OnDownloadUpdated(item_);
+  }
+}
+
+void ContentDownloadTask::CancelInternal() {
+  // An empty target makes content cancel a download it has not saved yet.
+  if (target_callback_) {
+    RunTargetCallback(base::FilePath());
+  } else if (item_ &&
+             item_->GetState() == ::download::DownloadItem::IN_PROGRESS) {
+    item_->Cancel(/*user_cancel=*/true);
+  }
+}
+
+std::string ContentDownloadTask::GetSuggestedName() const {
+  return suggested_name_;
+}
+
+void ContentDownloadTask::RunTargetCallback(const base::FilePath& path) {
+  if (!target_callback_) {
+    return;
+  }
+  ::download::DownloadTargetInfo target_info;
+  if (!path.empty()) {
+    target_info.target_path = path;
+    target_info.intermediate_path =
+        path.AddExtension(FILE_PATH_LITERAL(".crdownload"));
+    target_info.display_name = path.BaseName();
+    target_info.mime_type = item_ ? item_->GetMimeType() : std::string();
+    target_info.insecure_download_status =
+        ::download::DownloadItem::InsecureDownloadStatus::SAFE;
+  }
+  std::move(target_callback_).Run(std::move(target_info));
+}
+
+}  // namespace web
