 gfx::Size RenderWidgetHostViewIOS::GetCompositorViewportPixelSize() {
-  return gfx::ScaleToCeiledSize(
-      IsTesting() ? GetRequestedRendererSize() : GetScreenInfo().rect.size(),
-      GetDeviceScaleFactor());
+  // [ios-blink-sideload] The size the browser compositor shows the page's
+  // surface at, as on the Mac, instead of the screen's: a new surface id comes
+  // with every change of that size (BrowserCompositorIOS::
+  // UpdateSurfaceFromUIView()), not with one of the screen's. After a rotation
