+  // that started while the screen info was stale only covered part of the
+  // view.
+  return gfx::ScaleToCeiledSize(IsTesting()
+                                    ? GetRequestedRendererSize()
+                                    : browser_compositor_->GetRendererSize(),
+                                GetDeviceScaleFactor());
 }
 
