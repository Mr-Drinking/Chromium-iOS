 }  // namespace
 }  // namespace display
 
+namespace {
+// [ios-blink-sideload] KVO context for UIWindowScene's effectiveGeometry.
+void* kEffectiveGeometryContext = &kEffectiveGeometryContext;
+}  // namespace
+
 @interface ScreenObserver : NSObject {
   raw_ptr<display::ScreenNotification, DanglingUntriaged> _notifier;
+  // [ios-blink-sideload] The window scenes whose effectiveGeometry is observed.
+  NSMutableSet<UIWindowScene*>* _observedScenes;
 }
 - (void)mainScreenChanged;
 @end
@@ -46,11 +53,80 @@ - (instancetype)initWithNotifier:(display::ScreenNotification*)notifier {
                       selector:@selector(mainScreenChanged)
                           name:UIWindowDidBecomeKeyNotification
                         object:nil];
+#if !BUILDFLAG(IS_IOS_TVOS) && !BUILDFLAG(IS_IOS_APP_EXTENSION)
+    // [ios-blink-sideload] The device's orientation changes before the
+    // interface rotates, and the task posted for it ran before the scene had
+    // its new size: the display kept the previous orientation's size until
+    // the next rotation. Apple's way to follow rotations is to observe the
+    // scene's effectiveGeometry.
+    _observedScenes = [NSMutableSet set];
+    [defaultCenter addObserver:self
+                      selector:@selector(sceneWillConnect:)
+                          name:UISceneWillConnectNotification
+                        object:nil];
+    [defaultCenter addObserver:self
+                      selector:@selector(sceneDidDisconnect:)
+                          name:UISceneDidDisconnectNotification
+                        object:nil];
+    for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+      [self observeScene:scene];
+    }
+#endif
   }
 
   return self;
 }
 
+- (void)dealloc {
+  for (UIWindowScene* scene in _observedScenes) {
+    [scene removeObserver:self
+               forKeyPath:@"effectiveGeometry"
+                  context:kEffectiveGeometryContext];
+  }
+}
+
+- (void)observeScene:(UIScene*)scene {
+  UIWindowScene* windowScene = base::apple::ObjCCast<UIWindowScene>(scene);
+  if (!windowScene || [_observedScenes containsObject:windowScene]) {
+    return;
+  }
+  [_observedScenes addObject:windowScene];
+  [windowScene addObserver:self
+                forKeyPath:@"effectiveGeometry"
+                   options:0
+                   context:kEffectiveGeometryContext];
+}
+
+- (void)sceneWillConnect:(NSNotification*)notification {
+  [self observeScene:notification.object];
+}
+
+- (void)sceneDidDisconnect:(NSNotification*)notification {
+  UIWindowScene* windowScene =
+      base::apple::ObjCCast<UIWindowScene>(notification.object);
+  if (!windowScene || ![_observedScenes containsObject:windowScene]) {
+    return;
+  }
+  [windowScene removeObserver:self
+                   forKeyPath:@"effectiveGeometry"
+                      context:kEffectiveGeometryContext];
+  [_observedScenes removeObject:windowScene];
+}
+
+- (void)observeValueForKeyPath:(NSString*)keyPath
+                      ofObject:(id)object
+                        change:(NSDictionary*)change
+                       context:(void*)context {
+  if (context == kEffectiveGeometryContext) {
+    [self mainScreenChanged];
+    return;
+  }
+  [super observeValueForKeyPath:keyPath
+                       ofObject:object
+                         change:change
+                        context:context];
+}
+
 - (void)mainScreenChanged {
   if (!base::SingleThreadTaskRunner::HasCurrentDefault()) {
     return;
@@ -85,6 +161,32 @@ - (void)mainScreenChanged {
 #endif
 }
 
+#if !BUILDFLAG(IS_IOS_TVOS)
+// [ios-blink-sideload] The application's window scene, preferably the active
+// one, whose interface orientation the display follows.
+UIWindowScene* GetActiveWindowScene() {
+#if BUILDFLAG(IS_IOS_APP_EXTENSION)
+  return nil;
+#else
+  UIWindowScene* first_scene = nil;
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    auto* window_scene = base::apple::ObjCCast<UIWindowScene>(scene);
+    if (!window_scene || !window_scene.windows.count) {
+      continue;
+    }
+    if (window_scene.activationState ==
+        UISceneActivationStateForegroundActive) {
+      return window_scene;
+    }
+    if (!first_scene) {
+      first_scene = window_scene;
+    }
+  }
+  return first_scene;
+#endif
+}
+#endif  // !BUILDFLAG(IS_IOS_TVOS)
+
 class ScreenIos : public ScreenBase, public ScreenNotification {
  public:
   ScreenIos() {
@@ -101,8 +203,61 @@ void ScreenChanged() override {
       return;
     }
 
+    CGRect bounds = screen.bounds;
+#if !BUILDFLAG(IS_IOS_TVOS)
+    Display::Rotation rotation = Display::ROTATE_0;
+    // [ios-blink-sideload] Follow the interface's orientation, with the bounds
+    // that go with it, instead of the device's orientation and UIScreen's
+    // bounds: they change at different times during a rotation (the page was
+    // told "portrait-secondary" with portrait bounds in landscape), and the
+    // device may face a way the interface doesn't turn to.
+    if (UIWindowScene* window_scene = GetActiveWindowScene()) {
+      UIInterfaceOrientation orientation =
+          window_scene.effectiveGeometry.interfaceOrientation;
+      switch (orientation) {
+        case UIInterfaceOrientationPortraitUpsideDown:
+          rotation = Display::ROTATE_180;
+          break;
+        // The device turned left (UIDeviceOrientationLandscapeLeft).
+        case UIInterfaceOrientationLandscapeRight:
+          rotation = Display::ROTATE_90;
+          break;
+        case UIInterfaceOrientationLandscapeLeft:
+          rotation = Display::ROTATE_270;
+          break;
+        default:
+          rotation = Display::ROTATE_0;
+          break;
+      }
+      // The screen's bounds in portrait, turned like the interface.
+      CGSize size = screen.fixedCoordinateSpace.bounds.size;
+      if (UIInterfaceOrientationIsLandscape(orientation)) {
+        size = CGSizeMake(size.height, size.width);
+      }
+      bounds = CGRectMake(0, 0, size.width, size.height);
+    } else {
+      switch (UIDevice.currentDevice.orientation) {
+        case UIDeviceOrientationPortrait:
+        case UIDeviceOrientationFaceUp:
+        case UIDeviceOrientationFaceDown:
+        case UIDeviceOrientationUnknown:
+          rotation = Display::ROTATE_0;
+          break;
+        case UIDeviceOrientationPortraitUpsideDown:
+          rotation = Display::ROTATE_180;
+          break;
+        case UIDeviceOrientationLandscapeLeft:
+          rotation = Display::ROTATE_90;
+          break;
+        case UIDeviceOrientationLandscapeRight:
+          rotation = Display::ROTATE_270;
+          break;
+      }
+    }
+#endif
+
     const int64_t display_id = 0;
-    Display display(display_id, gfx::Rect(screen.bounds));
+    Display display(display_id, gfx::Rect(bounds));
     CGFloat scale = [screen scale];
 
     if (Display::HasForceDeviceScaleFactor()) {
@@ -111,24 +266,6 @@ void ScreenChanged() override {
