+++ b/ios/web/content/navigation/content_navigation_item.mm
@@ -191,11 +191,14 @@ ReferrerPolicy FromContentReferrerPolicy(
 }
 
 void ContentNavigationItem::SetUserAgentType(UserAgentType type) {
-  user_agent_type_ = type;
+  // [ios-blink-sideload] Desktop is content's user agent override (see
+  // ContentNavigationManager::ReloadWithUserAgentType()).
+  entry_->SetIsOverridingUserAgent(type == UserAgentType::DESKTOP);
 }
 
 UserAgentType ContentNavigationItem::GetUserAgentType() const {
-  return user_agent_type_;
+  return entry_->GetIsOverridingUserAgent() ? UserAgentType::DESKTOP
+                                            : UserAgentType::MOBILE;
 }
 
 void ContentNavigationItem::SetSecurityScopedFileResource(NSData* data) {
diff --git a/ios/web/content/navigation/content_navigation_manager.h b/ios/web/content/navigation/content_navigation_manager.h
index 4afc779055de2474d33634195e4728ed3b719bfc..6c5eeda0f02090a4a2e9ea339c86deb39d118f7f 100644
--- a/ios/web/content/navigation/content_navigation_manager.h
+++ b/ios/web/content/navigation/content_navigation_manager.h
@@ -15,12 +15,18 @@
 
 namespace content {
 class NavigationController;
+class WebContents;
 }  // namespace content
 
 namespace web {
 
 class ContentWebState;
 
+// [ios-blink-sideload] Gives `web_contents` the user agent that Request Desktop
+// Site loads pages with (Chrome on the Mac's), unless it has an override
+// already. Only entries that override the user agent use it.
+void SetDesktopUserAgentOverride(content::WebContents* web_contents);
+
 // ContentNavigationManager is a NavigationManager implementation that
 // is built on top of //content's NavigationController.
 class ContentNavigationManager : public NavigationManager {
diff --git a/ios/web/content/navigation/content_navigation_manager.mm b/ios/web/content/navigation/content_navigation_manager.mm
index 53606ced1e67201f2a88082ae65d9109235fd698..edba81fded200e001e2da3fa970a1b04fc10c640 100644
--- a/ios/web/content/navigation/content_navigation_manager.mm
+++ b/ios/web/content/navigation/content_navigation_manager.mm
@@ -11,9 +11,11 @@
 #import "base/apple/foundation_util.h"
 #import "base/notimplemented.h"
 #import "base/strings/sys_string_conversions.h"
+#import "components/embedder_support/user_agent_utils.h"
 #import "content/public/browser/navigation_controller.h"
 #import "content/public/browser/navigation_entry.h"
 #import "content/public/browser/navigation_handle.h"
+#import "content/public/browser/web_contents.h"
 #import "ios/web/content/navigation/content_navigation_item.h"
 #import "ios/web/content/web_state/content_web_state.h"
 #import "ios/web/navigation/navigation_context_impl.h"
@@ -22,6 +24,7 @@
 #import "ios/web/public/web_state_observer.h"
 #import "net/http/http_request_headers.h"
 #import "net/http/http_util.h"
+#import "third_party/blink/public/common/user_agent/user_agent_metadata.h"
 
 namespace web {
 
@@ -52,8 +55,38 @@
   }
 }
 
+// [ios-blink-sideload] Chrome on the Mac's user agent, for Request Desktop
+// Site (Chrome on Android uses Linux's), with client hints to match.
+blink::UserAgentOverride DesktopUserAgentOverride() {
+  const blink::UserAgentMetadata metadata =
+      embedder_support::GetUserAgentMetadata();
+  blink::UserAgentOverride ua_override;
+  ua_override.ua_string_override =
+      embedder_support::BuildUserAgentFromOSAndProduct(
+          "Macintosh; Intel Mac OS X 10_15_7",
+          embedder_support::GetProductAndVersion());
+  ua_override.ua_metadata_override = metadata;
+  ua_override.ua_metadata_override->platform = "macOS";
+  ua_override.ua_metadata_override->platform_version = std::string();
+  ua_override.ua_metadata_override->model = std::string();
+  ua_override.ua_metadata_override->mobile = false;
+  ua_override.ua_metadata_override->form_factors =
+      embedder_support::GetFormFactorsClientHint(metadata, /*is_mobile=*/false);
+  ua_override.ua_metadata_override->architecture = "arm";
+  ua_override.ua_metadata_override->bitness = "64";
+  ua_override.ua_metadata_override->wow64 = false;
+  return ua_override;
+}
+
 }  // namespace
 
+void SetDesktopUserAgentOverride(content::WebContents* web_contents) {
+  if (web_contents->GetUserAgentOverride().ua_string_override.empty()) {
+    web_contents->SetUserAgentOverride(DesktopUserAgentOverride(),
+                                       /*override_in_new_tabs=*/false);
+  }
+}
+
 ContentNavigationManager::ContentNavigationManager(
     ContentWebState* web_state,
     BrowserState* browser_state,
@@ -193,8 +226,28 @@
 
 void ContentNavigationManager::ReloadWithUserAgentType(
     UserAgentType user_agent_type) {
-  // TODO(crbug.com/40257932)
-  NOTIMPLEMENTED();
+  // [ios-blink-sideload] Request Desktop Site as Chrome on Android does it
+  // (NavigationControllerAndroid::SetUseDesktopUserAgent()): the current entry
+  // overrides the user agent, and its original request URL loads again. Pages
+  // opened from it, by link or address, keep the override.
+  content::NavigationEntry* entry = controller_->GetLastCommittedEntry();
+  if (!entry) {
+    return;
+  }
+  const bool desktop = user_agent_type == UserAgentType::DESKTOP;
+  content::WebContents* web_contents = web_state_->GetWebContents();
+  if (desktop) {
+    SetDesktopUserAgentOverride(web_contents);
+  }
+  entry->SetIsOverridingUserAgent(desktop);
+  // Recompute the page's preferences, as Android does
+  // (WebContentsImpl::UpdateOverridingUserAgent()). Content ignores the
+  // viewport meta tag on entries that override the user agent, so in desktop
+  // mode a page lays out at a desktop width, zoomed out to fit, instead of at
+  // the phone's width. The commit doesn't do it: the entry already has the
+  // flag, so content sees no change.
+  web_contents->NotifyPreferencesChanged();
+  controller_->LoadOriginalRequestURL();
 }
 
 std::vector<NavigationItem*> ContentNavigationManager::GetBackwardItems()
diff --git a/ios/web/content/web_state/content_web_state_builder.mm b/ios/web/content/web_state/content_web_state_builder.mm
index f6e8ba15b6c0d96110786e0e8697e6036b30045d..3b45d29de5f622cd7ec400b986b33b7b1218af7c 100644
--- a/ios/web/content/web_state/content_web_state_builder.mm
+++ b/ios/web/content/web_state/content_web_state_builder.mm
@@ -9,7 +9,9 @@
 #import "content/public/browser/navigation_controller.h"
 #import "content/public/browser/navigation_entry.h"
 #import "content/public/browser/restore_type.h"
+#import "content/public/browser/web_contents.h"
 #import "ios/web/content/content_browser_context.h"
+#import "ios/web/content/navigation/content_navigation_manager.h"
 #import "ios/web/content/web_state/content_web_state.h"
 #import "ios/web/navigation/proto_util.h"
 #import "ios/web/public/navigation/navigation_item.h"
@@ -31,6 +33,7 @@ void ExtractContentSessionStorage(ContentWebState* web_state,
   web_state->SetHasOpener(storage.has_opener());
   std::vector<std::unique_ptr<content::NavigationEntry>> items;
   int last_committed_item_index = -1;
+  bool restores_desktop_site = false;
 
   if (storage.has_navigation()) {
     const proto::NavigationStorage& navigation = storage.navigation();
@@ -67,6 +70,15 @@ void ExtractContentSessionStorage(ContentWebState* web_state,
       new_entry->SetTitle(base::UTF8ToUTF16(item.title()));
       new_entry->SetTransitionType(ui::PAGE_TRANSITION_RELOAD);
 
+      // [ios-blink-sideload] Keep Request Desktop Site across restarts: an
+      // item's user agent type is its entry's override flag (see
+      // ContentNavigationItem::SetUserAgentType()).
+      if (UserAgentTypeFromProto(item.user_agent()) ==
+          UserAgentType::DESKTOP) {
+        new_entry->SetIsOverridingUserAgent(true);
+        restores_desktop_site = true;
+      }
+
       if (item.has_http_request_headers()) {
         std::ostringstream buffer;
         for (const proto::HttpHeaderStorage& header :
@@ -105,8 +117,17 @@ void ExtractContentSessionStorage(ContentWebState* web_state,
     }
   }
 
+  // [ios-blink-sideload] The desktop entries need the desktop user agent, and
+  // the page's preferences (see ContentNavigationManager::
+  // ReloadWithUserAgentType()) must follow the restored entry.
+  if (restores_desktop_site) {
+    SetDesktopUserAgentOverride(web_state->GetWebContents());
+  }
   controller.Restore(last_committed_item_index, content::RestoreType::kRestored,
                      &items);
+  if (restores_desktop_site) {
+    web_state->GetWebContents()->NotifyPreferencesChanged();
+  }
 }
 
 void SerializeContentStorage(const ContentWebState* web_state,
diff --git a/third_party/blink/renderer/core/execution_context/navigator_base.cc b/third_party/blink/renderer/core/execution_context/navigator_base.cc
index 83f427c5ec9b75cbf41935af9935f9fa293ea11c..c3385b940aee8e5a8dae9f91b1a89a11dbf334c2 100644
--- a/third_party/blink/renderer/core/execution_context/navigator_base.cc
+++ b/third_party/blink/renderer/core/execution_context/navigator_base.cc
@@ -73,6 +73,13 @@ String NavigatorBase::platform() const {
   if (!RuntimeEnabledFeatures::ReduceUserAgentMinorVersionEnabled()) {
     return NavigatorID::platform();
   }
+#endif
+#if BUILDFLAG(IS_IOS)
+  // [ios-blink-sideload] Request Desktop Site gives the page a Mac's user agent
+  // and client hints; say Mac here too, as Safari does.
+  if (GetUserAgentMetadata().platform == "macOS") {
+    return "MacIntel";
+  }
 #endif
   return GetReducedNavigatorPlatform();
 }
