+
+// [ios-blink-sideload] gCrWeb now keeps its APIs in a private registry, so
+// `__gCrWeb.api.function()` no longer exists; call through
+// __gCrWeb.callFunctionInGcrWeb() like ios/web/js_messaging/web_frame_impl.mm.
+// `name` is "api.function".
 std::u16string CreateFunctionCallWithParameters(
     const std::string& name,
     const base::ListValue& parameters) {
@@ -37,8 +51,13 @@ void WebWithErrorToContentJavaScriptCallbackAdapter(
     parameter_strings[i] = base::WriteJson(parameters[i]).value_or("");
   }
   std::string joined_paramters = base::JoinString(parameter_strings, ",");
-  return base::UTF8ToUTF16(base::StringPrintf("__gCrWeb.%s(%s)", name.c_str(),
-                                              joined_paramters.c_str()));
+  std::optional<std::pair<std::string_view, std::string_view>> name_parts =
+      base::SplitStringOnce(name, '.');
+  std::string api_name(name_parts ? name_parts->first : "");
+  std::string function_name(name_parts ? name_parts->second : name);
+  return base::UTF8ToUTF16(base::StringPrintf(
+      "__gCrWeb.callFunctionInGcrWeb(\"%s\", \"%s\", [%s])",
+      api_name.c_str(), function_name.c_str(), joined_paramters.c_str()));
 }
 
