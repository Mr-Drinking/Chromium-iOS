diff --git a/ios/web/content/js_messaging/content_web_frames_manager.mm b/ios/web/content/js_messaging/content_web_frames_manager.mm
index 3fa96c90ba6f3ec8dc99bde1d4e1fbc5f8c87043..6883106f53b2c9fab0d9337b598003a006b77045 100644
--- a/ios/web/content/js_messaging/content_web_frames_manager.mm
+++ b/ios/web/content/js_messaging/content_web_frames_manager.mm
@@ -50,6 +50,22 @@
   return send_webkit_message_feature.get();
 }
 
+// [ios-blink-sideload] Without kContentEnableInjectedFeatureScripts (off by
+// default), still inject what translation needs: page language detection and
+// the translate script, plus the gCrWeb base and the message shim that their
+// scripts build on. The full set is 30-odd features whose scripts all run in
+// the page's own world here, each costing jitless V8 time on every page load.
+bool IsInjectedWithoutFlag(const JavaScriptFeature* feature) {
+  if (feature == GetSendWebKitMessageJavaScriptFeature() ||
+      feature == java_script_features::GetBaseJavaScriptFeature()) {
+    return true;
+  }
+  std::optional<std::string> handler_name =
+      feature->GetScriptMessageHandlerName();
+  return handler_name && (*handler_name == "LanguageDetectionTextCaptured" ||
+                          *handler_name == "TranslateMessage");
+}
+
 }  // namespace
 
 ContentWebFramesManager::ContentWebFramesManager(
@@ -79,6 +95,11 @@
            content_web_state->GetBrowserState())) {
     java_script_features.push_back(feature);
   }
+  if (!base::FeatureList::IsEnabled(kContentEnableInjectedFeatureScripts)) {
+    std::erase_if(java_script_features, [](JavaScriptFeature* feature) {
+      return !IsInjectedWithoutFlag(feature);
+    });
+  }
 
   js_feature_manager_ = std::make_unique<ContentJavaScriptFeatureManager>(
       std::move(java_script_features));
@@ -177,7 +198,9 @@
