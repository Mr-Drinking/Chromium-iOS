+// [ios-blink-sideload] Offer to translate even without a Google API key: the
+// translate element Chrome injects sends its translation requests with a key
+// of its own, so translation works in builds that have none.
+bool TranslateManager::ignore_missing_key_for_testing_ = true;
 
